<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Edit <%= p.name %> · Admin · RichManAssets</title>
<meta name="robots" content="noindex,nofollow"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --bg: #F8F6F2; --white: #FFFFFF; --surface2: #FAF8F5;
    --ink: #17150F; --ink-2: #3B362C; --muted: #8C8475;
    --line: #E5E0D8; --line2: #ECE7E0; --r: 20px; --r-sm: 12px; --r-pill: 999px;
  }
  body{font-family:'Plus Jakarta Sans','Inter',system-ui,sans-serif;background:var(--bg);color:var(--ink);font-size:14px;-webkit-font-smoothing:antialiased}
  .topbar{background:var(--white);color:var(--ink);display:flex;align-items:center;justify-content:space-between;padding:0 28px;height:64px;position:sticky;top:0;z-index:50;border-bottom:1px solid var(--line)}
  .topbar .brand{font-size:17px;font-weight:800;letter-spacing:-.03em}
  .topbar a{color:var(--ink-2);font-size:13px;font-weight:600;text-decoration:none;padding:8px 16px;background:var(--surface2);border-radius:var(--r-pill);transition:.18s}
  .topbar a:hover{background:var(--ink);color:#fff}
  .main{max-width:980px;margin:0 auto;padding:32px 24px}
  .back{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--muted);text-decoration:none;margin-bottom:20px;padding:6px 14px;background:var(--white);border-radius:var(--r-pill);border:1px solid var(--line)}
  .back:hover{color:var(--ink);border-color:var(--ink)}
  .flash-ok{background:#F0FAF4;color:#27694A;border:1px solid rgba(39,105,74,0.18);padding:14px 18px;border-radius:var(--r-sm);margin-bottom:24px;font-size:13.5px;font-weight:600}
  .flash-err{background:#FDF2F2;color:#D93838;border:1px solid rgba(217,56,56,0.18);padding:14px 18px;border-radius:var(--r-sm);margin-bottom:24px;font-size:13.5px;font-weight:600}
  .form-card{background:var(--white);border-radius:var(--r);padding:clamp(22px,4vw,36px);border:1px solid var(--line);padding-bottom:calc(clamp(22px,4vw,36px) + 76px)}
  .page-head{margin-bottom:28px}
  .page-head .eyebrow{display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:800;margin-bottom:6px}
  .page-head h2{font-size:26px;font-weight:800;letter-spacing:-.02em}
  .section{padding-top:28px;margin-top:28px;border-top:1px solid var(--line2)}
  .section:first-of-type{padding-top:0;margin-top:0;border-top:0}
  .section-head{margin-bottom:18px}
  .section-head .eyebrow{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800;margin-bottom:3px}
  .section-head h3{font-size:16px;font-weight:800;letter-spacing:-.01em;color:var(--ink)}
  .section-head p{font-size:12.5px;color:var(--muted);font-weight:500;margin-top:3px;line-height:1.4}
  .fg{display:grid;gap:16px;grid-template-columns:1fr 1fr}
  @media(max-width:700px){.fg{grid-template-columns:1fr}}
  @media(max-width:480px){.fg{grid-template-columns:1fr}}
  .fg.cols3{grid-template-columns:1fr 1fr 1fr}
  @media(max-width:700px){.fg.cols3{grid-template-columns:1fr}}
  @media(max-width:480px){.fg.cols3{grid-template-columns:1fr}}
  .fg.full{grid-template-columns:1fr}
  .field{display:flex;flex-direction:column;gap:6px;margin-bottom:6px}
  .field label{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2);font-weight:700;margin-top:4px}
  .field input:not([type=checkbox]):not([type=radio]),.field select,.field textarea{padding:13px 16px;border:1.5px solid var(--line);border-radius:var(--r-sm);font:inherit;font-size:14px;font-weight:500;color:var(--ink);outline:none;transition:border-color .18s, box-shadow .18s;background:var(--white);-webkit-appearance:none}
  .field input:focus,.field select:focus,.field textarea:focus{background:var(--white);border-color:var(--ink);box-shadow:0 0 0 3.5px rgba(28,25,23,0.08)}
  .field textarea{resize:vertical;min-height:100px}
  .field small,.form-hint{display:block;font-size:12px;color:var(--muted);font-weight:500;margin-top:5px;margin-bottom:14px;line-height:1.4}
  .form-actions{position:fixed;left:0;right:0;bottom:0;z-index:40;display:flex;justify-content:center;background:rgba(248,246,242,.9);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-top:1px solid var(--line)}
  .form-actions-inner{width:100%;max-width:980px;display:flex;gap:12px;flex-wrap:wrap;padding:16px 24px}
  .btn-primary{padding:13px 28px;background:var(--ink);color:#fff;border:0;border-radius:var(--r-pill);font:inherit;font-size:14px;font-weight:700;cursor:pointer;transition:.2s;box-shadow:0 4px 14px rgba(0,0,0,0.12)}
  .btn-primary:hover{background:#2A2A32;transform:translateY(-1px)}
  .btn-secondary{padding:13px 22px;background:var(--surface2);border:1px solid transparent;border-radius:var(--r-pill);font:inherit;font-size:14px;font-weight:700;color:var(--ink-2);cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;transition:.18s}
  .btn-secondary:hover{background:var(--ink);color:#fff}
  @media(max-width:700px){.form-actions-inner{padding:14px 16px}.form-actions-inner .btn-primary,.form-actions-inner .btn-secondary{flex:1;justify-content:center;text-align:center}}
</style>
</head>
<body>
<div class="topbar">
  <div class="brand">RichManAssets <span style="font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-left:8px;font-weight:700;vertical-align:2px">Admin</span></div>
  <a href="/admin">← Dashboard</a>
</div>

<div class="main">
  <a class="back" href="/admin">← Back to dashboard</a>
  <% if (flash) { %>
  <div class="<%= flash.type === 'ok' ? 'flash-ok' : 'flash-err' %>"><%= flash.msg %></div>
  <% } %>

  <div class="form-card">
    <div class="page-head">
      <span class="eyebrow">Editing property</span>
      <h2><%= p.name %></h2>
    </div>
    <form method="post" action="/admin/property/<%= p.id %>/edit" enctype="multipart/form-data">

      <div class="section">
        <div class="section-head"><span class="eyebrow">Basics</span><h3>Name, location &amp; type</h3></div>
        <div class="fg">
          <div class="field"><label>Property name *</label><input name="name" required value="<%= p.name %>"></div>
          <div class="field"><label>Slug / ID</label><input value="<%= p.id %>" disabled style="opacity:.5"><small>Cannot be changed after creation</small></div>
        </div>
        <div class="fg cols3">
          <div class="field"><label>Location *</label><input name="loc" required value="<%= p.loc %>"></div>
          <div class="field"><label>Area</label><input name="area" value="<%= p.area || '' %>"></div>
          <div class="field"><label>Type *</label>
            <select name="type" id="admin-ptype" required>
              <% ['Villa','House','Estate','Apartment','Plot','Commercial','Agricultural'].forEach(function(t) { %>
              <option <%= p.type === t ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="fg cols3">
          <div class="field"><label>Listing *</label>
            <select name="listing" required>
              <option value="sale" <%= p.listing === 'sale' ? 'selected' : '' %>>For Sale</option>
              <option value="rent" <%= p.listing === 'rent' ? 'selected' : '' %>>For Rent</option>
              <option value="lease" <%= p.listing === 'lease' ? 'selected' : '' %>>For Lease</option>
            </select>
          </div>
          <div class="field"><label>Price *</label><input name="price" required value="<%= p.price %>"></div>
          <div class="field"><label>Price suffix</label><input name="price_note" value="<%= p.price_note || '' %>"></div>
        </div>
        <div class="fg cols3">
          <div class="field"><label id="lbl-admin-beds">Bedrooms</label><input name="beds" id="admin-beds" value="<%= p.beds || '' %>"></div>
          <div class="field"><label id="lbl-admin-baths">Bathrooms</label><input name="baths" id="admin-baths" value="<%= p.baths || '' %>"></div>
          <div class="field"><label id="lbl-admin-sqft">Area / sqft</label><input name="sqft" id="admin-sqft" value="<%= p.sqft || '' %>"></div>
        </div>
        <div class="fg">
          <div class="field"><label>Subtype</label><input name="subtype" value="<%= p.subtype || '' %>"></div>
          <div class="field"><label>Price value (numeric)</label><input name="price_val" type="number" value="<%= p.price_val || 0 %>"></div>
        </div>
      </div>

      <div class="section">
        <div class="section-head"><span class="eyebrow">Story &amp; marketing</span><h3>What buyers read on the listing</h3></div>
        <div class="fg full">
          <div class="field"><label>Story kicker</label><input name="story_kicker" value="<%= p.story_kicker || '' %>"></div>
          <div class="field"><label>Story heading</label><input name="story_heading" value="<%= p.story_heading || '' %>"></div>
          <div class="field"><label>Story body</label><textarea name="story_body" rows="5"><%= p.story_body || '' %></textarea></div>
          <div class="field">
            <label>Amenities <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px;color:var(--muted)">(type and press Enter or comma)</span></label>
            <div class="tag-input" id="amen-tags" data-init="<%= (p.amenities||'').replace(/"/g,'&quot;') %>"></div>
            <input type="hidden" name="amenities" id="amenities-hidden" value="<%= p.amenities || '' %>">
          </div>
          <div class="field"><label>Setting heading</label><input name="setting_heading" value="<%= p.setting_heading || '' %>"></div>
          <div class="field"><label>Setting body</label><textarea name="setting_body" rows="3"><%= p.setting_body || '' %></textarea></div>
          <div class="field">
            <label>Location pills <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px;color:var(--muted)">(type and press Enter or comma)</span></label>
            <div class="tag-input" id="pills-tags" data-init="<%= (p.setting_pills||'').replace(/"/g,'&quot;') %>"></div>
            <input type="hidden" name="setting_pills" id="setting_pills-hidden" value="<%= p.setting_pills || '' %>">
          </div>
          <div class="field"><label>EMI label</label><input name="emi_label" value="<%= p.emi_label || '' %>" placeholder="e.g. 85% loan · 20y · 8.5%"></div>
          <div class="field"><label>EMI value</label><input name="emi_val" value="<%= p.emi_val || '' %>" placeholder="e.g. ₹5,53,237"></div>
        </div>
      </div>

      <div class="section field">
        <label>Property photos</label>
        <small style="margin-bottom:10px">Add up to 10. Pick a hero (property page header) and a thumbnail (listing grids) — the first photo covers both if you don't choose.</small>
        <% var galleryArr = []; try { galleryArr = JSON.parse(p.gallery || '[]'); } catch(_) {} %>
        <% var combinedArr = galleryArr.slice();
           if (p.img_card && combinedArr.indexOf(p.img_card) === -1) combinedArr.push(p.img_card);
           if (p.img_hero && combinedArr.indexOf(p.img_hero) === -1) combinedArr.push(p.img_hero);
           var heroToken = ''; if (p.img_hero) { var hi = combinedArr.indexOf(p.img_hero); if (hi !== -1) heroToken = 'e' + hi; }
           var cardToken = ''; if (p.img_card) { var ci = combinedArr.indexOf(p.img_card); if (ci !== -1) cardToken = 'e' + ci; }
        %>
        <div id="photo-grid">
          <% combinedArr.forEach(function(url, idx) { %>
          <div class="photo-card" data-token="e<%= idx %>">
            <div class="photo-frame">
              <img src="<%= cldOptimize(url.startsWith('http') ? url : '/' + url, {w:220}) %>" alt="Photo <%= idx+1 %>" class="photo-img" onerror="this.classList.add('broken-img')">
              <div class="photo-toolbar">
                <button type="button" class="photo-move" data-dir="-1" title="Move earlier">‹</button>
                <button type="button" class="photo-move" data-dir="1" title="Move later">›</button>
              </div>
              <label class="photo-remove"><input type="checkbox" name="gallery_remove[]" value="e<%= idx %>"><span>Remove</span></label>
              <span class="default-badge">Default</span>
            </div>
            <div class="photo-roles">
              <button type="button" class="role-chip" data-role="hero">Hero</button>
              <button type="button" class="role-chip" data-role="card">Thumbnail</button>
            </div>
          </div>
          <% }) %>
        </div>
        <input type="hidden" name="gallery_order" id="gallery_order-hidden" value="<%= combinedArr.map(function(_,i){return 'e'+i;}).join(',') %>">
        <input type="hidden" name="hero_pick" id="hero_pick-hidden" value="<%= heroToken %>">
        <input type="hidden" name="card_pick" id="card_pick-hidden" value="<%= cardToken %>">
        <input type="file" id="photo-input" name="gallery" multiple accept="image/jpeg,image/png,image/webp">
        <small style="margin-top:8px">JPG, PNG or WebP · 1200×800 recommended</small>
      </div>

      <div class="section">
        <div class="section-head"><span class="eyebrow">Visibility</span><h3>Where this listing appears</h3></div>
        <div class="fg">
          <div class="field"><label>Featured on homepage?</label>
            <select name="featured">
              <option value="0" <%= !p.featured ? 'selected' : '' %>>No</option>
              <option value="1" <%= p.featured ? 'selected' : '' %>>Yes</option>
            </select>
          </div>
          <div class="field"><label>Sort order</label><input name="sort_order" type="number" value="<%= p.sort_order || 99 %>" min="1" max="999"></div>
        </div>
      </div>

      <div class="form-actions">
        <div class="form-actions-inner">
          <button class="btn-primary" type="submit">Save changes →</button>
          <a class="btn-secondary" href="/admin">Cancel</a>
          <a class="btn-secondary" href="/property/<%= p.id %>" target="_blank">View on site ↗</a>
        </div>
      </div>
    </form>
  </div>
</div>

<style>
  #photo-grid{display:flex;flex-wrap:wrap;gap:14px;margin:4px 0 10px}
  .photo-card{width:150px;display:flex;flex-direction:column;gap:6px}
  .photo-frame{position:relative;border-radius:12px;overflow:hidden;border:1.5px solid var(--line);transition:border-color .18s, box-shadow .18s}
  .photo-card.is-hero .photo-frame,.photo-card.is-card .photo-frame{border-color:var(--ink);box-shadow:0 0 0 3px rgba(15,15,18,0.08)}
  .photo-img{width:150px;height:106px;object-fit:cover;display:block;background:var(--surface2)}
  .photo-img.broken-img{object-fit:contain;padding:10px}
  .photo-toolbar{position:absolute;top:6px;left:6px;display:flex;gap:4px}
  .photo-move{width:22px;height:22px;border:0;border-radius:6px;background:rgba(23,21,15,.62);color:#fff;font-size:12px;font-weight:700;cursor:pointer;line-height:1}
  .photo-move:hover{background:rgba(23,21,15,.85)}
  .photo-remove{position:absolute;top:6px;right:6px;background:rgba(23,21,15,.62);border-radius:6px;padding:4px 7px;cursor:pointer;display:flex;align-items:center;gap:4px}
  .photo-remove input{width:13px;height:13px;margin:0;accent-color:#E03E3E}
  .photo-remove span{font-size:10px;color:#fff;font-weight:700;letter-spacing:.02em}
  .photo-roles{display:flex;gap:6px}
  .role-chip{flex:1;padding:6px 0;border:1.5px solid var(--line);border-radius:var(--r-pill);background:var(--white);color:var(--ink-2);font:inherit;font-size:11px;font-weight:700;letter-spacing:.02em;cursor:pointer;transition:.16s}
  .role-chip:hover{border-color:var(--ink)}
  .role-chip.active{background:var(--ink);border-color:var(--ink);color:#fff}
  .default-badge{display:none;position:absolute;bottom:6px;left:6px;background:rgba(255,255,255,.92);color:var(--ink-2);font-size:9px;font-weight:700;letter-spacing:.04em;padding:3px 7px;border-radius:6px}
  .photo-card.is-implicit-default .default-badge{display:block}
  @media(max-width:480px){.photo-card{width:calc(50% - 7px)}.photo-img{width:100%}}
  .tag-input{display:flex;flex-wrap:wrap;gap:6px;padding:8px 12px;border:1px solid transparent;border-radius:12px;min-height:44px;cursor:text;background:var(--surface2)}
  .tag-input:focus-within{background:#fff;border-color:#0F0F12;box-shadow:0 0 0 3px rgba(15,15,18,0.06)}
  .tag-chip{display:inline-flex;align-items:center;gap:6px;background:#0F0F12;color:#fff;border-radius:999px;padding:4px 12px;font-size:12px;font-weight:700}
  .tag-chip button{background:none;border:0;cursor:pointer;color:#8E8E93;font-size:14px;line-height:1;padding:0 2px}
  .tag-chip button:hover{color:#E03E3E}
  .tag-typeahead{border:0;outline:0;flex:1;min-width:120px;font:inherit;font-size:13.5px;background:none;padding:2px 4px}
</style>
<script>
// ── property photos: reorder, hero/thumbnail pick, remove, new-file previews ──
(function() {
  var grid = document.getElementById('photo-grid');
  var orderHidden = document.getElementById('gallery_order-hidden');
  var heroHidden = document.getElementById('hero_pick-hidden');
  var cardHidden = document.getElementById('card_pick-hidden');
  var fileInput = document.getElementById('photo-input');
  if (!grid) return;

  function allCards() { return Array.from(grid.querySelectorAll('.photo-card')); }
  function existingCards() { return Array.from(grid.querySelectorAll('.photo-card[data-token^="e"]')); }

  function syncOrder() {
    orderHidden.value = existingCards().map(function(el) { return el.dataset.token; }).join(',');
  }

  function refreshRoles() {
    allCards().forEach(function(card) {
      var token = card.dataset.token;
      var isHero = token === heroHidden.value;
      var isCard = token === cardHidden.value;
      card.classList.toggle('is-hero', isHero);
      card.classList.toggle('is-card', isCard);
      var heroBtn = card.querySelector('.role-chip[data-role=hero]');
      var cardBtn = card.querySelector('.role-chip[data-role=card]');
      if (heroBtn) heroBtn.classList.toggle('active', isHero);
      if (cardBtn) cardBtn.classList.toggle('active', isCard);
    });
    refreshDefaultBadge();
  }

  function refreshDefaultBadge() {
    var cards = allCards();
    cards.forEach(function(card) { card.classList.remove('is-implicit-default'); });
    if (heroHidden.value || cardHidden.value) return;
    var visible = cards.filter(function(c) {
      var cb = c.querySelector('.photo-remove input');
      return !cb || !cb.checked;
    });
    if (visible[0]) visible[0].classList.add('is-implicit-default');
  }

  grid.addEventListener('click', function(e) {
    var moveBtn = e.target.closest('.photo-move');
    if (moveBtn) {
      var card = moveBtn.closest('.photo-card');
      var dir = parseInt(moveBtn.dataset.dir, 10);
      var sibling = dir < 0 ? card.previousElementSibling : card.nextElementSibling;
      if (!sibling || !sibling.classList.contains('photo-card') || !/^e/.test(sibling.dataset.token || '')) return;
      if (dir < 0) grid.insertBefore(card, sibling);
      else grid.insertBefore(sibling, card);
      syncOrder();
      refreshDefaultBadge();
      return;
    }
    var roleBtn = e.target.closest('.role-chip');
    if (roleBtn) {
      var card2 = roleBtn.closest('.photo-card');
      var hidden = roleBtn.dataset.role === 'hero' ? heroHidden : cardHidden;
      hidden.value = (hidden.value === card2.dataset.token) ? '' : card2.dataset.token;
      refreshRoles();
    }
  });

  grid.addEventListener('change', function(e) {
    if (!e.target.matches('.photo-remove input')) return;
    var card = e.target.closest('.photo-card');
    card.style.opacity = e.target.checked ? '.35' : '';
    if (e.target.checked) {
      if (heroHidden.value === card.dataset.token) heroHidden.value = '';
      if (cardHidden.value === card.dataset.token) cardHidden.value = '';
    }
    refreshRoles();
  });

  if (fileInput) {
    fileInput.addEventListener('change', function() {
      Array.from(grid.querySelectorAll('.photo-card[data-token^="n"]')).forEach(function(el) { el.remove(); });
      Array.from(fileInput.files).forEach(function(f, i) {
        var card = document.createElement('div');
        card.className = 'photo-card';
        card.dataset.token = 'n' + i;
        card.innerHTML =
          '<div class="photo-frame"><img class="photo-img" alt="New photo ' + (i + 1) + '"><span class="default-badge">Default</span></div>' +
          '<div class="photo-roles">' +
            '<button type="button" class="role-chip" data-role="hero">Hero</button>' +
            '<button type="button" class="role-chip" data-role="card">Thumbnail</button>' +
          '</div>';
        card.querySelector('.photo-img').src = URL.createObjectURL(f);
        grid.appendChild(card);
      });
      refreshRoles();
    });
  }

  syncOrder();
  refreshRoles();
})();

// ── tag-input ──
function initTagInput(containerEl, hiddenEl) {
  if (!containerEl || !hiddenEl) return;
  var chips = [];
  var input = document.createElement('input');
  input.className = 'tag-typeahead';
  input.placeholder = 'Type and press Enter…';
  containerEl.appendChild(input);

  function sync() { hiddenEl.value = chips.join('|'); }
  function addChip(val) {
    val = val.trim().replace(/,/g,'');
    if (!val || chips.indexOf(val) !== -1) return;
    chips.push(val);
    var chip = document.createElement('span');
    chip.className = 'tag-chip';
    chip.textContent = val;
    var del = document.createElement('button');
    del.type = 'button'; del.textContent = '×';
    del.addEventListener('click', function() {
      chips.splice(chips.indexOf(val), 1); chip.remove(); sync();
    });
    chip.appendChild(del);
    containerEl.insertBefore(chip, input);
    sync();
  }
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault(); addChip(input.value); input.value = '';
    } else if (e.key === 'Backspace' && !input.value && chips.length) {
      chips.pop();
      var all = containerEl.querySelectorAll('.tag-chip');
      all[all.length-1].remove(); sync();
    }
  });
  input.addEventListener('blur', function() {
    if (input.value.trim()) { addChip(input.value); input.value = ''; }
  });
  containerEl.addEventListener('click', function() { input.focus(); });

  (hiddenEl.value || '').split('|').forEach(function(v) { if (v.trim()) addChip(v.trim()); });
}

initTagInput(document.getElementById('amen-tags'), document.getElementById('amenities-hidden'));
initTagInput(document.getElementById('pills-tags'), document.getElementById('setting_pills-hidden'));

// Dynamic property type field adaptation
var ptype = document.getElementById('admin-ptype');
var lblBeds = document.getElementById('lbl-admin-beds');
var inputBeds = document.getElementById('admin-beds');
var lblBaths = document.getElementById('lbl-admin-baths');
var inputBaths = document.getElementById('admin-baths');
var lblSqft = document.getElementById('lbl-admin-sqft');
var inputSqft = document.getElementById('admin-sqft');

function updateFieldLabels() {
  if (!ptype) return;
  var v = (ptype.value || '').toLowerCase();
  if (v.includes('plot') || v.includes('land')) {
    if (lblBeds) lblBeds.textContent = 'Road Width / Facing';
    if (inputBeds) inputBeds.placeholder = 'e.g. 30 ft road · East facing';
    if (lblBaths) lblBaths.textContent = 'Plot Dimensions';
    if (inputBaths) inputBaths.placeholder = 'e.g. 40 x 60 ft';
    if (lblSqft) lblSqft.textContent = 'Plot Area (sqft / Cents)';
    if (inputSqft) inputSqft.placeholder = 'e.g. 10 Cents (4,356 sqft)';
  } else if (v.includes('agricultural')) {
    if (lblBeds) lblBeds.textContent = 'Irrigation Source';
    if (inputBeds) inputBeds.placeholder = 'e.g. Borewell & River stream';
    if (lblBaths) lblBaths.textContent = 'Soil Type / Crop';
    if (inputBaths) inputBaths.placeholder = 'e.g. Red fertile soil · Coconut plantation';
    if (lblSqft) lblSqft.textContent = 'Land Area (Acres)';
    if (inputSqft) inputSqft.placeholder = 'e.g. 3.5 Acres';
  } else if (v.includes('commercial') || v.includes('office') || v.includes('shop')) {
    if (lblBeds) lblBeds.textContent = 'Floor Level / Lift';
    if (inputBeds) inputBeds.placeholder = 'e.g. 2nd Floor (Lift available)';
    if (lblBaths) lblBaths.textContent = 'Washrooms / Parking';
    if (inputBaths) inputBaths.placeholder = 'e.g. 2 Washrooms · 4 Car parking';
    if (lblSqft) lblSqft.textContent = 'Carpet Area (sqft)';
    if (inputSqft) inputSqft.placeholder = 'e.g. 2,200 sqft';
  } else {
    if (lblBeds) lblBeds.textContent = 'Bedrooms';
    if (inputBeds) inputBeds.placeholder = 'e.g. 3 BHK';
    if (lblBaths) lblBaths.textContent = 'Bathrooms';
    if (inputBaths) inputBaths.placeholder = 'e.g. 3';
    if (lblSqft) lblSqft.textContent = 'Built-up Area (sqft)';
    if (inputSqft) inputSqft.placeholder = 'e.g. 2,400 sqft';
  }
}
if (ptype) {
  ptype.addEventListener('change', updateFieldLabels);
  updateFieldLabels();
}
</script>
</body>
</html>
