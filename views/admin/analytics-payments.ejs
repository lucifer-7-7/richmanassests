<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title><%= title %> · RichManAssets</title>
<meta name="robots" content="noindex,nofollow"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#F6F2EC; --white:#FFFFFF; --ink:#1C1917; --muted:#8C8275; --line:#E2DBD0;
  --ok:#27694A; --ok-bg:#F0FAF4; --err:#D93838; --err-bg:#FDF2F2; --gold:#B5934C;
}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--ink);padding-bottom:60px;}
.top{background:var(--white);height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50;}
.top .brand{font-size:18px;font-weight:800;letter-spacing:-.03em;}
.top .nav-links a{color:var(--ink);font-size:13px;text-decoration:none;padding:8px 16px;border-radius:999px;font-weight:600;background:#E8E2D8;margin-left:6px;}
.top .nav-links a.active{background:var(--ink);color:#fff;}
.container{max-width:1200px;margin:32px auto;padding:0 24px;}
.header{margin-bottom:24px;}
.header h1{font-size:28px;font-weight:800;letter-spacing:-.02em;}
.grid-4{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-bottom:32px;}
.stat-card{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:24px;}
.stat-card .num{font-size:32px;font-weight:800;margin-top:8px;}
.stat-card .label{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;}
.card-box{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:24px;margin-bottom:32px;}
.card-box h3{font-size:18px;font-weight:700;margin-bottom:16px;}
.table{width:100%;border-collapse:collapse;margin-top:12px;font-size:14px;}
.table th,.table td{padding:12px 16px;text-align:left;border-bottom:1px solid var(--line);}
.table th{font-weight:700;color:var(--muted);font-size:12px;text-transform:uppercase;}
.health-pill{display:inline-block;padding:6px 12px;border-radius:999px;font-size:12px;font-weight:700;}
.health-pill.green{background:#D1FAE5;color:#065F46;}
.health-pill.amber{background:#FEF3C7;color:#92400E;}
.btn-sm{padding:6px 12px;font-size:12px;border-radius:6px;background:var(--ink);color:#fff;border:none;cursor:pointer;}
</style>
</head>
<body>

<div class="top">
  <div class="brand">Rich<em>Man</em>Assets <span style="font-size:10px;padding:2px 8px;border:1px solid var(--line);border-radius:999px;">ADMIN</span></div>
  <div class="nav-links">
    <a href="/admin">Overview</a>
    <a href="/admin/analytics/agents">Agent Analytics</a>
    <a href="/admin/analytics/enquiries">Enquiry Analytics</a>
    <a href="/admin/analytics/payments" class="active">Payment Analytics</a>
    <a href="/admin/logout">Sign Out</a>
  </div>
</div>

<div class="container">
  <div class="header">
    <h1>Payment Analytics & Health Ledger</h1>
    <p style="color:var(--muted);">Gross vs Net revenue, success rates, failed error codes, Webhook health, and Reconciliation cron status.</p>
  </div>

  <div class="grid-4">
    <div class="stat-card">
      <div class="label">Gross Revenue</div>
      <div class="num" style="color:var(--ok)">₹<%= analytics.gross_revenue_rs.toLocaleString('en-IN') %></div>
    </div>
    <div class="stat-card">
      <div class="label">Net Revenue (Captured − Refunded)</div>
      <div class="num">₹<%= analytics.net_revenue_rs.toLocaleString('en-IN') %></div>
    </div>
    <div class="stat-card">
      <div class="label">Payment Success Rate</div>
      <div class="num"><%= analytics.payment_success_rate %>%</div>
    </div>
    <div class="stat-card">
      <div class="label">Avg Transaction Value</div>
      <div class="num">₹<%= analytics.avg_transaction_value_rs.toLocaleString('en-IN') %></div>
    </div>
  </div>

  <!-- Webhook & Reconciliation Health -->
  <div class="grid-4" style="grid-template-columns:1fr 1fr;gap:20px;">
    <div class="card-box" style="margin-bottom:0">
      <h3>Webhook Health Monitor</h3>
      <p style="margin-bottom:12px;"><span class="health-pill green">Status: Healthy</span></p>
      <div style="font-size:13px;line-height:1.6;">
        • <strong>Last Received:</strong> <%= analytics.webhook_health.last_webhook_received || 'No webhooks received yet' %><br>
        • <strong>Total Events Received:</strong> <%= analytics.webhook_health.total_received %><br>
        • <strong>Processing Success Rate:</strong> <%= analytics.webhook_health.success_rate %>%
      </div>
    </div>

    <div class="card-box" style="margin-bottom:0">
      <h3>Reconciliation Cron Health</h3>
      <p style="margin-bottom:12px;">
        <span class="health-pill <%= analytics.reconciliation_health.unresolved_count > 0 ? 'amber' : 'green' %>">
          Status: <%= analytics.reconciliation_health.status %>
        </span>
      </p>
      <div style="font-size:13px;line-height:1.6;">
        • <strong>Last Run:</strong> <%= analytics.reconciliation_health.last_run_at || 'Never run' %><br>
        • <strong>Mismatches Found:</strong> <%= analytics.reconciliation_health.mismatches_found %><br>
        • <strong>Auto-Healed Missed Webhooks:</strong> <strong style="color:var(--ok)"><%= analytics.reconciliation_health.auto_healed_count %></strong><br>
        • <strong>Unresolved Backlog:</strong> <%= analytics.reconciliation_health.unresolved_count %>
      </div>
    </div>
  </div>

  <div style="height:24px;"></div>

  <!-- Error Code Breakdown -->
  <div class="card-box">
    <h3>Failed Payment Breakdown by Error Code</h3>
    <table class="table">
      <thead>
        <tr>
          <th>Razorpay Error Code</th>
          <th>Failure Count</th>
        </tr>
      </thead>
      <tbody>
        <% if (Object.keys(analytics.error_code_breakdown).length === 0) { %>
        <tr><td colspan="2" style="color:var(--muted);">No payment errors logged. All transactions successful.</td></tr>
        <% } else { %>
        <% Object.keys(analytics.error_code_breakdown).forEach(code => { %>
        <tr>
          <td><strong style="color:var(--err)"><%= code %></strong></td>
          <td><%= analytics.error_code_breakdown[code] %></td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Payment Method Split -->
  <div class="card-box">
    <h3>Payment Method Distribution</h3>
    <table class="table">
      <thead>
        <tr>
          <th>Method (UPI / Card / Netbanking / Wallet)</th>
          <th>Transaction Count</th>
          <th>Total Volume (₹)</th>
        </tr>
      </thead>
      <tbody>
        <% if (Object.keys(analytics.method_split).length === 0) { %>
        <tr><td colspan="3" style="color:var(--muted);">No captured payments yet.</td></tr>
        <% } else { %>
        <% Object.keys(analytics.method_split).forEach(m => { %>
        <tr>
          <td><strong style="text-transform:uppercase"><%= m %></strong></td>
          <td><%= analytics.method_split[m].count %></td>
          <td>₹<%= (analytics.method_split[m].volume_paise / 100).toLocaleString('en-IN') %></td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Abandoned Orders & Refunds Summary -->
  <div class="grid-4" style="grid-template-columns:1fr 1fr;gap:20px;">
    <div class="card-box" style="margin-bottom:0">
      <h3>Abandoned / Pending Orders</h3>
      <div style="font-size:24px;font-weight:800;color:var(--err);margin:8px 0;">
        <%= analytics.abandoned_orders.count %> orders
      </div>
      <p style="font-size:13px;color:var(--muted);">Stuck in created/attempted status past 15 min.<br>Value: ₹<%= analytics.abandoned_orders.value_rs.toLocaleString('en-IN') %></p>
    </div>

    <div class="card-box" style="margin-bottom:0">
      <h3>Refund Summary</h3>
      <div style="font-size:24px;font-weight:800;color:var(--ink);margin:8px 0;">
        ₹<%= analytics.refund_metrics.total_refunded_rs.toLocaleString('en-IN') %>
      </div>
      <p style="font-size:13px;color:var(--muted);">Processed Refunds: <%= analytics.refund_metrics.refund_count %></p>
    </div>
  </div>

</div>
</body>
</html>
