<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title><%= title %> · RichManAssets</title>
<meta name="robots" content="noindex,nofollow"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#F6F2EC; --white:#FFFFFF; --ink:#1C1917; --muted:#8C8275; --line:#E2DBD0;
  --ok:#27694A; --ok-bg:#F0FAF4; --err:#D93838; --err-bg:#FDF2F2; --gold:#B5934C;
}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--ink);padding-bottom:60px;}
.top{background:var(--white);height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50;}
.top .brand{font-size:18px;font-weight:800;letter-spacing:-.03em;}
.top .nav-links a{color:var(--ink);font-size:13px;text-decoration:none;padding:8px 16px;border-radius:999px;font-weight:600;background:#E8E2D8;margin-left:6px;}
.top .nav-links a.active{background:var(--ink);color:#fff;}
.container{max-width:1200px;margin:32px auto;padding:0 24px;}
.header{margin-bottom:24px;}
.header h1{font-size:28px;font-weight:800;letter-spacing:-.02em;}
.grid-4{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-bottom:32px;}
.stat-card{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:24px;}
.stat-card .num{font-size:32px;font-weight:800;margin-top:8px;}
.stat-card .label{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;}
.card-box{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:24px;margin-bottom:32px;}
.card-box h3{font-size:18px;font-weight:700;margin-bottom:16px;}
.funnel-bar{display:flex;align-items:center;gap:12px;margin-bottom:12px;}
.funnel-bar .lbl{width:160px;font-weight:600;font-size:13px;}
.funnel-bar .bar-wrap{flex:1;background:#EAE4DC;height:24px;border-radius:12px;overflow:hidden;}
.funnel-bar .bar{height:100%;background:var(--ink);border-radius:12px;}
.table{width:100%;border-collapse:collapse;margin-top:12px;font-size:14px;}
.table th,.table td{padding:12px 16px;text-align:left;border-bottom:1px solid var(--line);}
.table th{font-weight:700;color:var(--muted);font-size:12px;text-transform:uppercase;}
.badge{padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;}
.badge.active{background:var(--ok-bg);color:var(--ok);}
.badge.draft{background:#EAE4DC;color:var(--ink);}
.badge.pending_payment{background:#FEF3C7;color:#92400E;}
</style>
</head>
<body>

<div class="top">
  <div class="brand">Rich<em>Man</em>Assets <span style="font-size:10px;padding:2px 8px;border:1px solid var(--line);border-radius:999px;">ADMIN</span></div>
  <div class="nav-links">
    <a href="/admin">Overview</a>
    <a href="/admin/analytics/agents" class="active">Agent Analytics</a>
    <a href="/admin/analytics/enquiries">Enquiry Analytics</a>
    <a href="/admin/analytics/payments">Payment Analytics</a>
    <a href="/admin/logout">Sign Out</a>
  </div>
</div>

<div class="container">
  <div class="header">
    <h1>Agent Analytics & Lifecycle</h1>
    <p style="color:var(--muted);">Real numbers, conversion funnel, time-to-activation, and agent performance.</p>
  </div>

  <div class="grid-4">
    <div class="stat-card">
      <div class="label">Total Registered Agents</div>
      <div class="num"><%= analytics.total_agents %></div>
    </div>
    <div class="stat-card">
      <div class="label">Avg Activation Time</div>
      <div class="num"><%= analytics.avg_activation_hours %> <span style="font-size:16px">hrs</span></div>
    </div>
    <div class="stat-card">
      <div class="label">Total Agent Revenue</div>
      <div class="num" style="color:var(--ok)">₹<%= analytics.total_revenue_rs.toLocaleString('en-IN') %></div>
    </div>
    <div class="stat-card">
      <div class="label">Avg Revenue Per Agent (ARPU)</div>
      <div class="num">₹<%= analytics.arpu_rs.toLocaleString('en-IN') %></div>
    </div>
  </div>

  <!-- Signup Funnel -->
  <div class="card-box">
    <h3>Agent Signup & Activation Funnel</h3>
    <div class="funnel-bar">
      <div class="lbl">1. Registered</div>
      <div class="bar-wrap"><div class="bar" style="width: 100%;"></div></div>
      <div style="font-weight:700;"><%= analytics.funnel.registered %></div>
    </div>
    <div class="funnel-bar">
      <div class="lbl">2. Verified</div>
      <div class="bar-wrap"><div class="bar" style="width: <%= analytics.funnel.registered > 0 ? (analytics.funnel.verified / analytics.funnel.registered * 100).toFixed(0) : 0 %>%;"></div></div>
      <div style="font-weight:700;"><%= analytics.funnel.verified %></div>
    </div>
    <div class="funnel-bar">
      <div class="lbl">3. Published a listing</div>
      <div class="bar-wrap"><div class="bar" style="background:#10b981; width: <%= analytics.funnel.registered > 0 ? (analytics.funnel.published / analytics.funnel.registered * 100).toFixed(0) : 0 %>%;"></div></div>
      <div style="font-weight:700;"><%= analytics.funnel.published %></div>
    </div>
    <div style="margin-top:16px;font-size:13px;color:var(--muted);">
      <strong>Drop-off Rates:</strong> Registered → Verified: <%= analytics.funnel_dropoff.registered_to_verified %>% | Verified → Published: <%= analytics.funnel_dropoff.verified_to_published %>%
    </div>
  </div>

  <!-- Status Breakdown -->
  <div class="card-box">
    <h3>Agent Status Breakdown</h3>
    <table class="table">
      <thead>
        <tr>
          <th>Status</th>
          <th>Agent Count</th>
          <th>Percentage %</th>
        </tr>
      </thead>
      <tbody>
        <% analytics.status_breakdown.forEach(st => { %>
        <tr>
          <td><span class="badge <%= st.status %>"><%= st.status %></span></td>
          <td><strong><%= st.count %></strong></td>
          <td><%= st.percentage %>%</td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Agent Leaderboard -->
  <div class="card-box">
    <h3>Agent Performance Leaderboard</h3>
    <table class="table">
      <thead>
        <tr>
          <th>Agent Name</th>
          <th>Enquiries Handled</th>
          <th>Conversions</th>
          <th>Conversion Rate</th>
        </tr>
      </thead>
      <tbody>
        <% if (analytics.leaderboard.length === 0) { %>
        <tr><td colspan="4" style="color:var(--muted);">No enquiry activity recorded yet.</td></tr>
        <% } else { %>
        <% analytics.leaderboard.forEach(ag => { %>
        <tr>
          <td><strong><%= ag.name %></strong></td>
          <td><%= ag.handled %></td>
          <td><%= ag.converted %></td>
          <td><strong style="color:var(--ok)"><%= ag.conversion_rate %>%</strong></td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
