<%
  var navLabel = isEdit ? 'listings' : 'new';
  var pageLabel = isEdit ? ('Edit: ' + (prop && prop.name ? prop.name : 'Listing')) : 'Add New Listing';
%>
<%- include('../partials/agent-layout-start', { activeNav: navLabel, pageTitle: pageLabel }) %>

<% if (flash) { %><div class="flash <%= flash.type %>"><%- flash.msg %></div><% } %>

<form method="post" action="<%= isEdit ? '/agent/listings/' + prop.id + '/edit' : '/agent/listings' %>" enctype="multipart/form-data" id="listingForm" class="form-card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- BASIC INFO -->
  <div class="form-section">
    <div class="form-section-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;">
      <span>Property Details</span>
      <span id="autosaveStatus" style="font-size:12px;font-weight:500;color:var(--muted);letter-spacing:0;text-transform:none;"></span>
    </div>
    <div class="form-group">
      <label for="pname">Property Name <span style="color:#D93838;font-weight:700">*</span></label>
      <input type="text" id="pname" name="name" required placeholder="e.g. Sea-View Villa, Kapu" value="<%= prop && prop.name ? prop.name : '' %>">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="ploc">Location / Address <span style="color:#D93838;font-weight:700">*</span></label>
        <input type="text" id="ploc" name="loc" required placeholder="e.g. Kapu, Udupi District" value="<%= prop && prop.loc ? prop.loc : '' %>">
      </div>
      <div class="form-group">
        <label for="parea">Area / Locality</label>
        <input type="text" id="parea" name="area" placeholder="e.g. Udupi" value="<%= prop && prop.area ? prop.area : '' %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="ptype">Property Type <span style="color:#D93838;font-weight:700">*</span></label>
        <select id="ptype" name="type" required>
          <option value="">Select type…</option>
          <% ['Apartment','Villa','House','Plot','Land','Commercial','Office','Shop','Agricultural','Penthouse','Bungalow','Row House','Other'].forEach(function(t) { %>
          <option value="<%=t%>" <%= prop && prop.type === t ? 'selected' : '' %>><%=t%></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="plisting">Listed For <span style="color:#D93838;font-weight:700">*</span></label>
        <select id="plisting" name="listing" required>
          <option value="">Select…</option>
          <option value="sale"  <%= prop && prop.listing === 'sale'  ? 'selected' : '' %>>Sale</option>
          <option value="rent"  <%= prop && prop.listing === 'rent'  ? 'selected' : '' %>>Rent</option>
          <option value="lease" <%= prop && prop.listing === 'lease' ? 'selected' : '' %>>Lease</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="pprice">Price Display <span style="color:#D93838;font-weight:700">*</span></label>
        <input type="text" id="pprice" name="price" required placeholder="e.g. ₹85 Lakhs or ₹25,000/mo" value="<%= prop && prop.price ? prop.price : '' %>">
        <div class="form-hint">Always include ₹ symbol. Text shown on the listing card.</div>
      </div>
      <div class="form-group">
        <label for="pprice_val">Price Value (₹ numeric) <span style="color:#D93838;font-weight:700">*</span></label>
        <input type="number" id="pprice_val" name="price_val" required min="0" step="1" placeholder="8500000" value="<%= prop && prop.price_val ? prop.price_val : '' %>">
        <div class="form-hint">Used for budget filtering. No commas.</div>
      </div>
    </div>
    <div class="form-group">
      <label for="pprice_note">Price Note</label>
      <input type="text" id="pprice_note" name="price_note" placeholder="e.g. Negotiable · Bank loan available" value="<%= prop && prop.price_note ? prop.price_note : '' %>">
    </div>
  </div>

  <!-- SPECS -->
  <div class="form-section">
    <div class="form-section-title">Specifications & Features</div>
    <div class="form-row">
      <div class="form-group" id="grp-beds">
        <label for="pbeds" id="lbl-beds">Bedrooms / Key Feature <span style="color:#D93838">*</span></label>
        <input type="text" id="pbeds" name="beds" required placeholder="e.g. 3 BHK" value="<%= prop && prop.beds ? prop.beds : '' %>">
      </div>
      <div class="form-group" id="grp-baths">
        <label for="pbaths" id="lbl-baths">Bathrooms / Dimensions <span style="color:#D93838">*</span></label>
        <input type="text" id="pbaths" name="baths" required placeholder="e.g. 2" value="<%= prop && prop.baths ? prop.baths : '' %>">
      </div>
      <div class="form-group" id="grp-sqft">
        <label for="psqft" id="lbl-sqft">Area (sqft / Acres / Cents) <span style="color:#D93838">*</span></label>
        <input type="text" id="psqft" name="sqft" required placeholder="e.g. 1,800 sqft" value="<%= prop && prop.sqft ? prop.sqft : '' %>">
      </div>
    </div>
    <div class="form-group">
      <label for="psubtype">Sub-type / Key Highlight</label>
      <input type="text" id="psubtype" name="subtype" placeholder="e.g. Beachfront, Gated community, Corner Plot, Main Road facing" value="<%= prop && prop.subtype ? prop.subtype : '' %>">
    </div>
  </div>

  <!-- DESCRIPTION -->
  <div class="form-section">
    <div class="form-section-title">Description & Amenities</div>
    <div class="form-group">
      <label for="pdesc">Property Description <span style="color:#D93838">*</span></label>
      <textarea id="pdesc" name="description" rows="5" required placeholder="Describe the property in detail — location highlights, views, condition, neighbourhood…"><%= prop && prop.description ? prop.description : '' %></textarea>
      <div class="form-hint">Minimum 40 characters.</div>
    </div>
    <div class="form-group">
      <label for="pamen">Amenities <span style="color:#D93838">*</span></label>
      <textarea id="pamen" name="amenities" rows="3" required placeholder="e.g. Swimming Pool · Gym · 24/7 Security · Parking · Backup Power"><%= prop && prop.amenities ? prop.amenities : '' %></textarea>
      <div class="form-hint">List at least one. Separate with · (bullet) or new lines.</div>
    </div>
  </div>

  <!-- OPTIONAL PAGE COPY OVERRIDES -->
  <div class="form-section">
    <details>
      <summary class="form-section-title" style="cursor:pointer;">Customize Page Text (optional)</summary>
      <div class="form-hint" style="margin:8px 0 16px;">Leave blank to use the auto-generated defaults shown on the live page.</div>
      <div class="form-group">
        <label for="pstoryk">Headline Label</label>
        <input type="text" id="pstoryk" name="story_kicker" placeholder="e.g. House for Sale in Udupi" value="<%= prop && prop.story_kicker ? prop.story_kicker : '' %>">
      </div>
      <div class="form-group">
        <label for="pstoryh">Headline</label>
        <input type="text" id="pstoryh" name="story_heading" placeholder="e.g. A 2-Bedroom House in Udupi." value="<%= prop && prop.story_heading ? prop.story_heading : '' %>">
      </div>
      <div class="form-group">
        <label for="pamenk">Amenities Section Label</label>
        <input type="text" id="pamenk" name="amenities_kicker" placeholder="What's here" value="<%= prop && prop.amenities_kicker ? prop.amenities_kicker : '' %>">
      </div>
      <div class="form-group">
        <label for="pamenh">Amenities Section Title</label>
        <input type="text" id="pamenh" name="amenities_heading" placeholder="The essentials" value="<%= prop && prop.amenities_heading ? prop.amenities_heading : '' %>">
      </div>
      <div class="form-group">
        <label for="psetk">Details Panel Label</label>
        <input type="text" id="psetk" name="setting_kicker" placeholder="Good to know" value="<%= prop && prop.setting_kicker ? prop.setting_kicker : '' %>">
      </div>
      <div class="form-group">
        <label for="pseth">Details Panel Title (writes a full custom "setting" write-up instead of the auto facts list)</label>
        <input type="text" id="pseth" name="setting_heading" placeholder="e.g. Peaceful, well-connected neighbourhood" value="<%= prop && prop.setting_heading ? prop.setting_heading : '' %>">
      </div>
      <div class="form-group">
        <label for="psetb">Details Panel Write-up</label>
        <textarea id="psetb" name="setting_body" rows="3" placeholder="Only used if Details Panel Title above is filled in."><%= prop && prop.setting_body ? prop.setting_body : '' %></textarea>
      </div>
      <div class="form-group">
        <label for="psetp">Details Panel Tags</label>
        <input type="text" id="psetp" name="setting_pills" placeholder="e.g. Near Highway | 10 min to Market | Gated Community" value="<%= prop && prop.setting_pills ? prop.setting_pills : '' %>">
        <div class="form-hint">Separate with | (pipe). Shown under the write-up above.</div>
      </div>
    </details>
  </div>

  <!-- IMAGES -->
  <div class="form-section">
    <div class="form-section-title">Property Images</div>
    <% if (isEdit && prop) { %>
    <% if (prop.img_card) { %>
    <div class="form-group">
      <label>Current Card Image</label>
      <div class="img-preview-wrap"><img src="<%- cldOptimize(prop.img_card, {w:260}) %>" class="img-preview" alt="Card"></div>
    </div>
    <% } %>
    <% if (prop.img_hero) { %>
    <div class="form-group">
      <label>Current Hero Image</label>
      <div class="img-preview-wrap"><img src="<%- cldOptimize(prop.img_hero, {w:260}) %>" class="img-preview" alt="Hero"></div>
    </div>
    <% } %>
    <% if (prop.gallery) {
      var gallery = [];
      try { gallery = JSON.parse(prop.gallery); } catch(_) {}
      if (gallery.length) { %>
    <div class="form-group">
      <label>Gallery (<%= gallery.length %> images)</label>
      <div class="img-preview-wrap">
        <% gallery.forEach(function(g,i) { %>
        <div>
          <img src="<%- cldOptimize(g, {w:180}) %>" class="img-preview" alt="Gallery <%=i+1%>">
          <div style="font-size:11px;color:var(--muted);text-align:center;margin-top:2px">
            <label style="cursor:pointer;text-transform:none;letter-spacing:0;font-size:11px;color:var(--danger)">
              <input type="checkbox" name="gallery_remove[]" value="<%=i%>" style="margin-right:2px">Remove
            </label>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } } %>
    <% } %>
    <div class="form-row">
      <div class="form-group">
        <label for="img_card">Card / Thumbnail Image</label>
        <input type="file" id="img_card" name="img_card" accept="image/jpeg,image/png,image/webp">
        <div class="form-hint">JPEG/PNG/WebP. Auto-compressed to ~3 MB, max 8 MB.</div>
        <div id="img_card_status" class="form-hint" style="min-height:14px"></div>
      </div>
      <div class="form-group">
        <label for="img_hero">Hero / Full-size Image <span style="color:#D93838;font-weight:700">* (Compulsory)</span></label>
        <input type="file" id="img_hero" name="img_hero" accept="image/jpeg,image/png,image/webp" <%= (!isEdit || !prop || !prop.img_hero) ? 'required' : '' %>>
        <div class="form-hint">Compulsory primary image. Auto-compressed to ~3 MB, max 8 MB.</div>
        <div id="img_hero_status" class="form-hint" style="min-height:14px"></div>
      </div>
    </div>
    <div class="form-group">
      <label for="gallery">Gallery Images (up to 10)</label>
      <input type="file" id="gallery" name="gallery" multiple accept="image/jpeg,image/png,image/webp">
      <div class="form-hint">Each image auto-compressed to ~3 MB, max 8 MB.</div>
      <div id="gallery_status" class="form-hint" style="min-height:14px"></div>
    </div>
  </div>

  <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:24px;">
    <button type="button" class="btn btn-outline" onclick="RMAPreview.open(document.getElementById('listingForm'))" style="order:-1;">
      👁️ Preview Listing
    </button>
    <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
      <%= isEdit ? 'Save & Proceed to Payment →' : 'Proceed to Payment →' %>
    </button>
    <a href="/agent/listings" class="btn btn-outline">Cancel</a>
  </div>
</form>

<div id="rmaPreviewContainer"></div>

<script>
(function() {
  var form = document.getElementById('listingForm');
  var btn = document.getElementById('submitBtn');
  var statusEl = document.getElementById('autosaveStatus');
  var draftKey = 'rma_draft_' + (<%- JSON.stringify(isEdit && prop ? prop.id : 'new') %>);

  // Auto-restore saved draft if creating new listing and inputs are empty
  try {
    var saved = localStorage.getItem(draftKey);
    if (saved && !<%- JSON.stringify(isEdit) %>) {
      var data = JSON.parse(saved);
      var restored = false;
      Object.keys(data).forEach(function(k) {
        var el = form.elements[k];
        if (el && !el.value && data[k] && el.type !== 'file') {
          el.value = data[k];
          restored = true;
        }
      });
      if (restored && statusEl) {
        statusEl.textContent = 'Unsaved draft restored';
        statusEl.style.color = '#3b82f6';
      }
    }
  } catch(_) {}

  // Auto-save input changes locally as the user types
  var timer = null;
  form.addEventListener('input', function(e) {
    if (e.target.type === 'file' || e.target.name === '_csrf') return;
    clearTimeout(timer);
    timer = setTimeout(function() {
      try {
        var data = {};
        var fields = ['name','loc','area','type','listing','price','price_val','price_note','beds','baths','sqft','subtype','description','amenities'];
        fields.forEach(function(f) {
          if (form.elements[f]) data[f] = form.elements[f].value;
        });
        localStorage.setItem(draftKey, JSON.stringify(data));
        if (statusEl) {
          statusEl.textContent = 'Draft auto-saved';
          statusEl.style.color = '#10b981';
        }
      } catch(_) {}
    }, 400);
  });

  // Dynamic property type field adaptation
  var ptype = document.getElementById('ptype');
  var lblBeds = document.getElementById('lbl-beds');
  var inputBeds = document.getElementById('pbeds');
  var lblBaths = document.getElementById('lbl-baths');
  var inputBaths = document.getElementById('pbaths');
  var lblSqft = document.getElementById('lbl-sqft');
  var inputSqft = document.getElementById('psqft');

  function updateFieldLabels() {
    if (!ptype) return;
    var v = (ptype.value || '').toLowerCase();
    if (v.includes('plot') || v.includes('land')) {
      if (lblBeds) lblBeds.textContent = 'Road Width / Facing';
      if (inputBeds) inputBeds.placeholder = 'e.g. 30 ft road · East facing';
      if (lblBaths) lblBaths.textContent = 'Plot Dimensions';
      if (inputBaths) inputBaths.placeholder = 'e.g. 40 x 60 ft';
      if (lblSqft) lblSqft.textContent = 'Plot Area (sqft / Cents)';
      if (inputSqft) inputSqft.placeholder = 'e.g. 10 Cents (4,356 sqft)';
    } else if (v.includes('agricultural')) {
      if (lblBeds) lblBeds.textContent = 'Irrigation Source';
      if (inputBeds) inputBeds.placeholder = 'e.g. Borewell & River stream';
      if (lblBaths) lblBaths.textContent = 'Soil Type / Crop';
      if (inputBaths) inputBaths.placeholder = 'e.g. Red fertile soil · Coconut plantation';
      if (lblSqft) lblSqft.textContent = 'Land Area (Acres)';
      if (inputSqft) inputSqft.placeholder = 'e.g. 3.5 Acres';
    } else if (v.includes('commercial') || v.includes('office') || v.includes('shop')) {
      if (lblBeds) lblBeds.textContent = 'Floor Level / Lift';
      if (inputBeds) inputBeds.placeholder = 'e.g. 2nd Floor (Lift available)';
      if (lblBaths) lblBaths.textContent = 'Washrooms / Parking';
      if (inputBaths) inputBaths.placeholder = 'e.g. 2 Washrooms · 4 Car parking';
      if (lblSqft) lblSqft.textContent = 'Carpet Area (sqft)';
      if (inputSqft) inputSqft.placeholder = 'e.g. 2,200 sqft';
    } else {
      if (lblBeds) lblBeds.textContent = 'Bedrooms';
      if (inputBeds) inputBeds.placeholder = 'e.g. 3 BHK';
      if (lblBaths) lblBaths.textContent = 'Bathrooms';
      if (inputBaths) inputBaths.placeholder = 'e.g. 3';
      if (lblSqft) lblSqft.textContent = 'Built-up Area (sqft)';
      if (inputSqft) inputSqft.placeholder = 'e.g. 2,400 sqft';
    }
  }
  if (ptype) {
    ptype.addEventListener('change', updateFieldLabels);
    updateFieldLabels();
  }

  // Validate images on form submission
  form.addEventListener('submit', function(e) {
    var heroInput = document.getElementById('img_hero');
    var cardInput = document.getElementById('img_card');
    var galleryInput = document.getElementById('gallery');
    var heroHasFile = heroInput && heroInput.files && heroInput.files.length > 0;
    var cardHasFile = cardInput && cardInput.files && cardInput.files.length > 0;
    var galleryHasFile = galleryInput && galleryInput.files && galleryInput.files.length > 0;
    var existingImages = <%- JSON.stringify((prop && (prop.img_hero || prop.img_card || (prop.gallery && JSON.parse(prop.gallery || '[]').length > 0))) ? true : false) %>;
    if (!heroHasFile && !cardHasFile && !galleryHasFile && !existingImages) {
      e.preventDefault();
      alert('Please upload at least one property image before proceeding.');
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Saving & Processing…';
    try { localStorage.removeItem(draftKey); } catch(_) {}
  });
})();
</script>

<script src="/assets/agent-image-compress.js" defer></script>
<script src="/assets/agent-preview.js" defer></script>

<%- include('../partials/agent-layout-end') %>
