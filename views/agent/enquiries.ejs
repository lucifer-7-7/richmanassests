<%- include('../partials/agent-layout-start', { activeNav: 'enquiries', pageTitle: 'Property Enquiries' }) %>

<div class="ap-card">
  <div class="ap-card-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
    <div>
      <h2 style="font-family:var(--font-serif);font-size:22px;font-weight:500;color:var(--ink);">Buyer Leads &amp; Property Enquiries</h2>
      <div style="font-size:13px;color:var(--muted);margin-top:2px;">Incoming buyer enquiries for your active property listings</div>
    </div>
    <% if (enquiries && enquiries.length > 0) { %>
    <span style="font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--gold);background:var(--gold-bg);padding:6px 14px;border-radius:100px;border:1px solid rgba(181,147,76,0.3);">
      <%= enquiries.length %> <%= enquiries.length === 1 ? 'Lead Received' : 'Leads Received' %>
    </span>
    <% } %>
  </div>

  <% if (!enquiries || enquiries.length === 0) { %>
  <div class="empty-state" style="padding:60px 24px;text-align:center;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:48px;height:48px;color:var(--muted);margin-bottom:12px;opacity:0.6;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
    <h3 style="font-family:var(--font-serif);font-size:22px;margin-bottom:8px;">No property enquiries yet</h3>
    <p style="color:var(--muted);font-size:14px;max-width:420px;margin:0 auto 20px;">When buyers inquire about your properties or request site visits, their details and messages will appear here instantly.</p>
    <a href="/agent/listings" class="btn btn-primary">View Your Listings →</a>
  </div>
  <% } else { %>
  <div style="padding:20px;">
    <% enquiries.forEach(function(eq) { 
      var cleanPhone = (eq.phone || '').replace(/\D/g, '');
      var waPhone = cleanPhone.length === 10 ? '91' + cleanPhone : cleanPhone;
      var waReply = 'Hi ' + (eq.name || 'there') + ', thank you for your enquiry regarding ' + (eq.property_name || 'our property listing') + '. How can I assist you?';
    %>
    <div class="ap-listing-item" style="display:flex;flex-direction:column;gap:14px;background:#FFFFFF;border:1.5px solid var(--border);border-radius:16px;padding:20px;margin-bottom:14px;box-shadow:0 4px 16px rgba(0,0,0,0.03);">
      
      <!-- Lead Top Bar -->
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;border-bottom:1px solid var(--border2);padding-bottom:12px;">
        <div>
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <span style="font-size:16.5px;font-weight:700;color:var(--ink);"><%= eq.name || 'Anonymous Buyer' %></span>
            <% if (!eq.is_read) { %>
            <span style="background:#FFFBEB;color:#B45309;border:1px solid #FDE68A;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;letter-spacing:.05em;text-transform:uppercase;">NEW</span>
            <% } else { %>
            <span style="background:#F4F4F5;color:#52525B;border:1px solid #E4E4E7;font-size:10px;font-weight:800;padding:2px 8px;border-radius:999px;letter-spacing:.05em;text-transform:uppercase;">READ</span>
            <% } %>
          </div>
          <div style="font-size:12.5px;color:var(--muted);margin-top:3px;">
            Received <%= new Date(eq.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
          </div>
        </div>

        <% if (eq.property_id) { %>
        <a href="/property/<%= eq.property_id %>" target="_blank" class="btn btn-outline btn-sm" style="font-size:11.5px;padding:6px 12px;">
          View Property ↗
        </a>
        <% } %>
      </div>

      <!-- Property & Buyer Contact Grid -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));gap:12px;background:var(--surface2);padding:12px 14px;border-radius:12px;border:1px solid var(--border2);">
        <div>
          <div style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:2px;">Property</div>
          <div style="font-size:13.5px;font-weight:700;color:var(--ink);"><%= eq.property_name || eq.property_ref || 'General Property Inquiry' %></div>
        </div>
        <div>
          <div style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:2px;">Phone</div>
          <a href="tel:<%= eq.phone %>" style="font-size:13.5px;font-weight:700;color:var(--ink);text-decoration:none;"><%= eq.phone || '—' %></a>
        </div>
        <% if (eq.email) { %>
        <div>
          <div style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:2px;">Email</div>
          <a href="mailto:<%= eq.email %>" style="font-size:13.5px;font-weight:600;color:var(--ink);text-decoration:none;"><%= eq.email %></a>
        </div>
        <% } %>
      </div>

      <!-- Message Content -->
      <% if (eq.message) { %>
      <div style="font-size:14px;color:var(--ink-2);background:#FAF8F5;padding:12px 14px;border-radius:10px;border-left:3px solid var(--gold);line-height:1.5;">
        "<%= eq.message %>"
      </div>
      <% } %>

      <!-- Action Row -->
      <div style="display:flex;justify-content:flex-end;align-items:center;gap:8px;border-top:1px solid var(--border2);padding-top:12px;flex-wrap:wrap;">
        <% if (!eq.is_read) { %>
        <form method="post" action="/agent/enquiries/<%= eq.id %>/read" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-ghost btn-sm">Mark Read</button>
        </form>
        <% } %>
        <% if (eq.phone) { %>
        <a href="tel:<%= eq.phone %>" class="btn btn-outline btn-sm">
          📞 Call Buyer
        </a>
        <a href="https://wa.me/<%= waPhone %>?text=<%= encodeURIComponent(waReply) %>" target="_blank" class="btn btn-primary btn-sm" style="background:#25D366;border-color:#25D366;">
          💬 Reply on WhatsApp
        </a>
        <% } %>
      </div>

    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<%- include('../partials/agent-layout-end') %>
