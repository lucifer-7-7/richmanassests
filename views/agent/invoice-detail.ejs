<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title><%= title %></title>
<meta name="robots" content="noindex,nofollow"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1C1917;
    --muted: #78716C;
    --line: #E7E5E4;
    --gold: #B5934C;
    --gold-bg: #FAF6EF;
    --success: #15803D;
    --success-bg: #F0FDF4;
    --paper: #FFFFFF;
    --bg: #F5F3EF;
  }
  
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--ink);
    padding: 40px 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .no-print-bar {
    max-width: 820px;
    margin: 0 auto 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 100px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all .2s;
    border: 1px solid transparent;
  }
  .btn-dark {
    background: var(--ink);
    color: #FFF;
  }
  .btn-dark:hover { background: #342F2C; }
  .btn-outline {
    background: #FFF;
    border-color: var(--line);
    color: var(--ink);
  }
  .btn-outline:hover { background: #FAF8F5; border-color: var(--ink); }

  /* INVOICE CANVAS CARD */
  .inv-paper {
    max-width: 820px;
    margin: 0 auto;
    background: var(--paper);
    border-radius: 20px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.06);
    padding: 48px;
    position: relative;
    overflow: hidden;
  }

  .inv-gold-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 6px;
    background: linear-gradient(90deg, #9A7B3F, #D4AF37, #9A7B3F);
  }

  .inv-top-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 32px;
  }

  .inv-brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .inv-brand-mark {
    width: 32px; height: 32px;
    background: var(--ink);
    color: #FFF;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Newsreader', serif;
    font-weight: 600;
    font-size: 18px;
  }
  .inv-brand-title {
    font-family: 'Newsreader', serif;
    font-size: 24px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -.02em;
  }
  .inv-brand-sub {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }

  .inv-meta-right {
    text-align: right;
  }
  .inv-title-badge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #FFF;
    background: var(--ink);
    padding: 5px 14px;
    border-radius: 100px;
    display: inline-block;
    margin-bottom: 14px;
  }
  .inv-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }
  .inv-date {
    font-size: 13px;
    color: var(--muted);
    margin-top: 4px;
  }

  /* BILLED TO / FROM GRID */
  .inv-party-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 24px;
    background: #FAF8F5;
    border-radius: 14px;
    border: 1px solid #F0EDE6;
    margin-bottom: 32px;
  }
  .party-title {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .party-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .party-info {
    font-size: 12.5px;
    color: #44403C;
    line-height: 1.6;
  }

  /* TABLE STYLING */
  .inv-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 32px;
  }
  .inv-table th {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 12px 14px;
    background: #FAF8F5;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .inv-table td {
    padding: 16px 14px;
    border-bottom: 1px solid #F5F3EF;
    font-size: 13.5px;
    vertical-align: top;
  }
  .item-desc-title {
    font-weight: 700;
    color: var(--ink);
    font-size: 14.5px;
    margin-bottom: 2px;
  }
  .item-desc-sub {
    font-size: 12px;
    color: var(--muted);
  }
  .item-sac {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #A8A29E;
  }

  /* TOTALS SUMMARY BOX */
  .inv-summary-wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    margin-bottom: 36px;
  }

  .stamp-box {
    border: 2px dashed #22C55E;
    background: #F0FDF4;
    padding: 16px 20px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #15803D;
  }
  .stamp-icon {
    width: 28px; height: 28px;
    background: #22C55E;
    color: #FFF;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800;
    font-size: 14px;
  }
  .stamp-text-title { font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .stamp-text-sub { font-size: 11px; color: #166534; }

  .totals-table {
    width: 320px;
    border-collapse: collapse;
  }
  .totals-table td {
    padding: 8px 0;
    font-size: 13px;
    color: var(--muted);
  }
  .totals-table td.val {
    text-align: right;
    font-weight: 600;
    color: var(--ink);
    font-family: 'JetBrains Mono', monospace;
  }
  .totals-table tr.grand-total td {
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    padding: 12px 0;
    font-size: 17px;
    font-weight: 800;
    color: var(--ink);
  }
  .totals-table tr.grand-total td.val {
    font-size: 19px;
    color: var(--ink);
  }

  /* FOOTER */
  .inv-footer {
    border-top: 1px solid var(--line);
    padding-top: 24px;
    font-size: 12px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .inv-notes { max-width: 480px; line-height: 1.6; }
  .inv-sign-box { text-align: right; }
  .inv-sign-line {
    border-bottom: 1px dashed var(--ink);
    width: 160px;
    margin-bottom: 6px;
    margin-left: auto;
  }

  /* PRINT MEDIA */
  @media print {
    body { background: #FFF; padding: 0; margin: 0; }
    .no-print-bar { display: none !important; }
    .inv-paper {
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 24px 16px;
      max-width: 100%;
    }
  }
</style>
</head>
<body>

<!-- TOP ACTION CONTROLS (NO PRINT) -->
<div class="no-print-bar">
  <a href="/agent/invoices" class="btn btn-outline">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <span>Back to Invoices</span>
  </a>
  <div style="display:flex;gap:10px;">
    <button onclick="window.print()" class="btn btn-dark">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      <span>Print / Save PDF</span>
    </button>
  </div>
</div>

<!-- INVOICE CANVAS CARD -->
<div class="inv-paper">
  <div class="inv-gold-bar"></div>

  <!-- HEADER -->
  <div class="inv-top-grid">
    <div>
      <div class="inv-brand-logo">
        <div class="inv-brand-mark">R</div>
        <div class="inv-brand-title">RichManAssets</div>
      </div>
      <div class="inv-brand-sub">Real Estate Agency &amp; Property Platform</div>
      <div style="font-size:12px;color:var(--muted);line-height:1.5;">
        <strong>Vittu Bharat Associates LLP</strong><br>
        2nd Floor, Sri Ram Building, Bannanje Road<br>
        Udupi, Karnataka — 576101, India<br>
        GSTIN: <span style="font-family:'JetBrains Mono',monospace;">29AAAFV1234F1Z8</span> · SAC: 998313
      </div>
    </div>
    
    <div class="inv-meta-right">
      <span class="inv-title-badge">TAX INVOICE / RECEIPT</span>
      <div class="inv-num">#<%= order.internal_order_id || order.razorpay_order_id %></div>
      <div class="inv-date">Date: <strong><%= new Date(order.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></strong></div>
      <div style="font-size:11.5px;color:var(--muted);margin-top:4px;">Payment Gateway: <strong>Razorpay PG</strong></div>
    </div>
  </div>

  <!-- SUPPLIER & CUSTOMER DETAILS -->
  <div class="inv-party-grid">
    <div>
      <div class="party-title">Supplier (Billed From)</div>
      <div class="party-name">Vittu Bharat Associates LLP</div>
      <div class="party-info">
        RichManAssets HQ, Bannanje Road<br>
        Udupi District, Karnataka — 576101<br>
        Email: hello@richmanassets.com<br>
        Phone: +91 90360 01234
      </div>
    </div>

    <div>
      <div class="party-title">Customer (Billed To)</div>
      <div class="party-name"><%= agent.name %></div>
      <div class="party-info">
        <% if (agent.company_name) { %><strong><%= agent.company_name %></strong><br><% } %>
        Email: <%= agent.email %><br>
        <% if (agent.phone) { %>Phone: +91 <%= agent.phone %><br><% } %>
        <% if (agent.city) { %>City: <%= agent.city %>, Karnataka<br><% } %>
        <% if (agent.gst_number) { %>GSTIN: <span style="font-family:'JetBrains Mono',monospace;"><%= agent.gst_number %></span><% } %>
      </div>
    </div>
  </div>

  <!-- ITEM TABLE -->
  <%
    const grandTotal = (order.amount_paise || 99900) / 100;
    const taxableVal = +(grandTotal / 1.18).toFixed(2);
    const totalGst   = +(grandTotal - taxableVal).toFixed(2);
    const cgst       = +(totalGst / 2).toFixed(2);
    const sgst       = +(totalGst / 2).toFixed(2);
    const propName   = order.agent_properties && order.agent_properties.name ? order.agent_properties.name : 'Property Listing License';
    const propLoc    = order.agent_properties && order.agent_properties.loc ? order.agent_properties.loc : 'Udupi / Coastal Karnataka';
  %>

  <table class="inv-table">
    <thead>
      <tr>
        <th style="text-align:left;">Service Description</th>
        <th style="text-align:center;">SAC Code</th>
        <th style="text-align:right;">Taxable Value</th>
        <th style="text-align:right;">GST Rate</th>
        <th style="text-align:right;">Total (₹)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="text-align:left;">
          <div class="item-desc-title">Annual Property Listing &amp; Publishing License (1 Year)</div>
          <div class="item-desc-sub">Listing: <strong><%= propName %></strong> (<%= propLoc %>)</div>
          <div class="item-desc-sub" style="margin-top:2px;">Includes 12-month active status, buyer lead routing &amp; map placement.</div>
        </td>
        <td style="text-align:center;" class="item-sac">998313</td>
        <td style="text-align:right;font-family:'JetBrains Mono',monospace;">₹<%= taxableVal.toFixed(2) %></td>
        <td style="text-align:right;font-size:12.5px;color:var(--muted);">18% GST</td>
        <td style="text-align:right;font-family:'JetBrains Mono',monospace;font-weight:700;">₹<%= grandTotal.toFixed(2) %></td>
      </tr>
    </tbody>
  </table>

  <!-- TOTALS & PAID STAMP -->
  <div class="inv-summary-wrap">
    <div class="stamp-box">
      <div class="stamp-icon">✓</div>
      <div>
        <div class="stamp-text-title">Payment Received</div>
        <div class="stamp-text-sub">Ref: <%= order.razorpay_payment_id || order.internal_order_id %></div>
      </div>
    </div>

    <table class="totals-table">
      <tr>
        <td>Subtotal (Taxable):</td>
        <td class="val">₹<%= taxableVal.toFixed(2) %></td>
      </tr>
      <tr>
        <td>CGST (9%):</td>
        <td class="val">₹<%= cgst.toFixed(2) %></td>
      </tr>
      <tr>
        <td>SGST (9%):</td>
        <td class="val">₹<%= sgst.toFixed(2) %></td>
      </tr>
      <tr class="grand-total">
        <td>Total Paid:</td>
        <td class="val">₹<%= grandTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
      </tr>
    </table>
  </div>

  <!-- FOOTER -->
  <div class="inv-footer">
    <div class="inv-notes">
      <strong>Terms &amp; Conditions:</strong><br>
      1. This tax invoice is computer-generated and legally valid under CGST/SGST Rules.<br>
      2. The property listing fee covers 365 days of active publishing from the date of payment.<br>
      3. For billing support or GST input tax credit queries, contact <strong>hello@richmanassets.com</strong>.
    </div>

    <div class="inv-sign-box">
      <div class="inv-sign-line"></div>
      <strong style="color:var(--ink);font-size:13px;">Authorized Signatory</strong><br>
      <span style="font-size:11px;color:var(--muted);">Vittu Bharat Associates LLP</span>
    </div>
  </div>
</div>

</body>
</html>
