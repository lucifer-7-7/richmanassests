<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
<style>
  .error-page { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; padding: clamp(40px, 8vw, 80px) 20px; text-align: center; }
  .error-icon { font-size: 80px; margin-bottom: 24px; }
  .error-page h1 { font-family: var(--f-display); font-size: clamp(32px, 5vw, 56px); font-weight: 400; margin-bottom: 12px; letter-spacing: -0.02em; }
  .error-page p { font-size: 15px; color: var(--ink-3); max-width: 50ch; margin-bottom: 32px; line-height: 1.6; }
  .error-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn { padding: 12px 28px; border-radius: 6px; font-size: 14px; text-decoration: none; font-weight: 500; border: none; cursor: pointer; transition: 0.3s; }
  .btn-primary { background: var(--ink); color: var(--paper); }
  .btn-primary:hover { background: var(--accent); }
  .btn-secondary { background: var(--paper-2); color: var(--ink); border: 1px solid var(--line); }
  .btn-secondary:hover { border-color: var(--ink); background: var(--paper); }
</style>
</head>
<body>
<%- include('partials/nav') %>

<div class="error-page">
  <div class="error-icon">⚠️</div>
  <h1>Something went wrong</h1>
  <p>Our servers encountered an error processing your request. Our team has been notified. Please try again in a few moments.</p>
  <div class="error-actions">
    <a href="/" class="btn btn-primary">Go to Homepage</a>
    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
  </div>
</div>

<%- include('partials/footer') %>
</body>
</html>
