<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
<link rel="stylesheet" href="/assets/property.css">
<style>
  .post-hero{background:var(--ink);color:var(--paper);padding:clamp(120px,15vw,170px) 0 clamp(48px,6vw,72px)}
  .crumb{display:flex;align-items:center;gap:8px;font-family:var(--f-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(247,244,237,.5);margin-bottom:20px;flex-wrap:wrap}
  .crumb a{color:rgba(247,244,237,.5);text-decoration:none}.crumb a:hover{color:var(--paper)}
  .crumb .sep{color:rgba(247,244,237,.25)}
  .post-cat{font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:block}
  .post-hero h1{font-family:var(--f-display);font-weight:400;font-size:clamp(30px,5vw,58px);line-height:1.04;letter-spacing:-.02em;text-wrap:balance;max-width:22ch}
  .post-meta-row{display:flex;flex-wrap:wrap;gap:18px;margin-top:22px;font-family:var(--f-mono);font-size:11.5px;letter-spacing:.04em;color:rgba(247,244,237,.6)}

  .post-body{padding:clamp(48px,7vw,80px) 0}
  .post-layout{display:grid;gap:clamp(32px,5vw,60px);max-width:760px;margin:0 auto}
  .article-prose{font-size:clamp(15px,1.5vw,16.5px);line-height:1.78;color:var(--ink-2)}
  .article-prose .lead{font-size:clamp(17px,1.9vw,20px);line-height:1.6;color:var(--ink);font-weight:500;margin-bottom:28px}
  .article-prose h2{font-family:var(--f-display);font-weight:500;font-size:clamp(23px,2.6vw,32px);letter-spacing:-.015em;margin:44px 0 16px;color:var(--ink)}
  .article-prose h3{font-family:var(--f-display);font-weight:500;font-size:clamp(18px,2vw,23px);letter-spacing:-.01em;margin:30px 0 12px;color:var(--ink)}
  .article-prose p{margin-bottom:18px}
  .article-prose ul,.article-prose ol{margin:0 0 20px;padding-left:22px}
  .article-prose li{margin-bottom:10px}
  .article-prose a{color:var(--accent);text-decoration:underline;text-decoration-color:var(--line)}
  .article-prose strong{color:var(--ink);font-weight:600}
  table.pt{width:100%;border-collapse:collapse;margin:24px 0;font-size:13.5px}
  table.pt th,table.pt td{padding:12px 14px;border-bottom:1px solid var(--line-soft);text-align:left}
  table.pt th{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);background:var(--paper-2)}
  table.pt tr:last-child td{border-bottom:none}

  .post-faq{max-width:760px;margin:0 auto;padding-top:12px}
  .post-faq h2{font-family:var(--f-display);font-weight:500;font-size:clamp(22px,2.6vw,30px);margin-bottom:14px}
  .faq-list{display:flex;flex-direction:column;gap:0;margin-top:8px}
  .faq-item{border-bottom:1px solid var(--line-soft)}
  .faq-item summary{list-style:none;cursor:pointer;padding:18px 36px 18px 0;position:relative;font-family:var(--f-display);font-size:clamp(16px,1.9vw,18px);font-weight:400;color:var(--ink);transition:color .2s}
  .faq-item summary::-webkit-details-marker{display:none}
  .faq-item summary::after{content:"+";position:absolute;right:4px;top:50%;transform:translateY(-50%);font-size:22px;color:var(--accent);transition:transform .3s;line-height:1}
  .faq-item[open] summary::after{content:"–"}
  .faq-item summary:hover{color:var(--accent)}
  .faq-item .faq-answer{padding:0 0 20px;color:var(--ink-3);font-size:14.5px;line-height:1.65;max-width:64ch}

  .related-sec{max-width:900px;margin:clamp(56px,7vw,88px) auto 0;padding-top:clamp(40px,5vw,56px);border-top:1px solid var(--line-soft)}
  .related-sec h2{font-family:var(--f-display);font-weight:500;font-size:clamp(22px,2.6vw,28px);margin-bottom:22px}
  .related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px}
  .related-card{display:block;text-decoration:none;color:inherit;border:1px solid var(--line);border-radius:12px;padding:18px 20px;transition:.2s}
  .related-card:hover{border-color:var(--accent);transform:translateY(-2px)}
  .related-card span{font-family:var(--f-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}
  .related-card h4{font-family:var(--f-display);font-size:16px;font-weight:500;margin-top:8px;line-height:1.3}
</style>
</head>
<body>
<%- include('partials/nav') %>

<header class="post-hero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a><span class="sep">/</span><a href="/blog">Property Guides</a><span class="sep">/</span><span><%= post.title %></span></div>
    <span class="post-cat"><%= post.category %></span>
    <h1><%= post.title %></h1>
    <div class="post-meta-row">
      <span><%= post.author_name %></span>
      <span>&middot;</span>
      <span><%= new Date(post.published_at).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
      <span>&middot;</span>
      <span><%= post.reading_time_min %> min read</span>
    </div>
  </div>
</header>

<article class="post-body">
  <div class="wrap post-layout">
    <div class="article-prose"><%- post.content_html %></div>

    <% if (post.faq && post.faq.length) { %>
    <div class="post-faq">
      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        <% post.faq.forEach(function(f, i) { %>
        <details class="faq-item" <%= i === 0 ? 'open' : '' %>>
          <summary><%= f.q %></summary>
          <p class="faq-answer"><%= f.a %></p>
        </details>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (related && related.length) { %>
    <div class="related-sec">
      <h2>More guides you might find useful</h2>
      <div class="related-grid">
        <% related.forEach(function(r) { %>
        <a class="related-card" href="/blog/<%= r.slug %>">
          <span><%= r.category %></span>
          <h4><%= r.title %></h4>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</article>

<section class="lead">
  <div class="wrap"><div class="lead-grid" style="grid-template-columns:1fr;text-align:center;place-items:center">
    <div>
      <span class="kicker" style="color:var(--gold)"><span class="gold-line"></span>Ready to act on this?</span>
      <h2 style="margin-top:14px">Let's find your <span class="it">next move.</span></h2>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:24px">
        <a class="btn btn-dark" href="/contact"><span>Talk to us</span><span class="arr">→</span></a>
        <a class="btn btn-ghost" href="/properties"><span>Browse properties</span></a>
      </div>
    </div>
  </div></div>
</section>

<%- include('partials/footer') %>
</body>
</html>
