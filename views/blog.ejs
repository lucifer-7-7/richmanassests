<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
<link rel="stylesheet" href="/assets/property.css">
<style>
  .blog-hero{
    background:var(--ink);color:var(--paper);
    padding:clamp(120px,16vw,180px) 0 clamp(56px,8vw,88px);
    position:relative;overflow:hidden;
  }
  .blog-hero::before{
    content:"";position:absolute;right:-10%;top:-20%;
    width:60vw;max-width:700px;aspect-ratio:1;border-radius:50%;
    background:radial-gradient(circle,rgba(154,123,63,.12),transparent 70%);
    pointer-events:none;
  }
  .blog-hero h1{
    font-family:var(--f-display);font-weight:400;
    font-size:clamp(36px,6vw,72px);line-height:.98;letter-spacing:-.024em;
    text-wrap:balance;max-width:18ch;
  }
  .blog-hero h1 .it{font-style:italic;color:var(--accent-soft)}
  .blog-hero p{margin-top:18px;max-width:56ch;font-size:clamp(15px,1.5vw,17px);line-height:1.68;color:rgba(247,244,237,.74)}
  .crumb{display:flex;align-items:center;gap:8px;font-family:var(--f-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(247,244,237,.5);margin-bottom:20px}
  .crumb a{color:rgba(247,244,237,.5);text-decoration:none}.crumb a:hover{color:var(--paper)}
  .crumb .sep{color:rgba(247,244,237,.25)}

  .blog-filters{display:flex;flex-wrap:wrap;gap:8px;padding:28px 0 4px}
  .blog-filters a{
    font-family:var(--f-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;
    padding:8px 16px;border:1px solid var(--line);border-radius:100px;color:var(--ink-3);
    text-decoration:none;transition:.2s;
  }
  .blog-filters a:hover,.blog-filters a.active{border-color:var(--ink);color:var(--ink);background:var(--paper-2)}

  .blog-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:clamp(18px,2vw,28px);padding:32px 0 clamp(64px,8vw,100px)}
  .blog-card{
    display:flex;flex-direction:column;border:1px solid var(--line);border-radius:14px;overflow:hidden;
    text-decoration:none;color:inherit;transition:.3s ease;background:var(--paper);
  }
  .blog-card:hover{border-color:var(--accent);transform:translateY(-3px)}
  .blog-card-img{aspect-ratio:16/10;background-size:cover;background-position:center;background-color:var(--paper-2)}
  .blog-card-body{padding:20px 22px 24px;display:flex;flex-direction:column;gap:10px}
  .blog-card-cat{font-family:var(--f-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
  .blog-card h3{font-family:var(--f-display);font-size:clamp(19px,2vw,23px);font-weight:500;letter-spacing:-.01em;line-height:1.18}
  .blog-card p{font-size:13.5px;line-height:1.6;color:var(--ink-3)}
  .blog-card-meta{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.06em;color:var(--muted);margin-top:auto;padding-top:6px}
</style>
</head>
<body>
<%- include('partials/nav') %>

<header class="blog-hero">
  <div class="wrap">
    <div class="crumb"><a href="/">Home</a><span class="sep">/</span><span>Property Guides</span></div>
    <h1>Property guides for <span class="it">Udupi & Manipal.</span></h1>
    <p>Straight answers on prices, RERA, home loans, NRI purchases and where to invest — written by the consultants who close these deals, not a content mill.</p>
  </div>
</header>

<div class="wrap">
  <% if (categories.length > 1) { %>
  <div class="blog-filters">
    <a href="/blog" class="<%= !activeCategory ? 'active' : '' %>">All</a>
    <% categories.forEach(function(c) { %>
    <a href="/blog?category=<%= encodeURIComponent(c) %>" class="<%= activeCategory === c ? 'active' : '' %>"><%= c %></a>
    <% }) %>
  </div>
  <% } %>

  <% if (!posts.length) { %>
  <div style="padding:80px 0;text-align:center;color:var(--ink-3)">
    <h3>No guides in this category yet</h3>
    <p><a href="/blog" style="color:var(--accent)">See all guides</a></p>
  </div>
  <% } else { %>
  <div class="blog-grid">
    <% posts.forEach(function(p) { %>
    <a class="blog-card reveal" href="/blog/<%= p.slug %>">
      <div class="blog-card-img" style="background-image:url('<%= p.cover_image %>')"></div>
      <div class="blog-card-body">
        <span class="blog-card-cat"><%= p.category %></span>
        <h3><%= p.title %></h3>
        <p><%= p.excerpt %></p>
        <span class="blog-card-meta"><%= p.reading_time_min %> min read</span>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<section class="lead">
  <div class="wrap"><div class="lead-grid" style="grid-template-columns:1fr;text-align:center;place-items:center">
    <div>
      <span class="kicker" style="color:var(--gold)"><span class="gold-line"></span>Have a specific question?</span>
      <h2 style="margin-top:14px">Talk to someone who actually<br><span class="it">closes these deals.</span></h2>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:24px">
        <a class="btn btn-dark" href="/contact"><span>Talk to us</span><span class="arr">→</span></a>
        <a class="btn btn-ghost" href="/properties"><span>Browse properties</span></a>
      </div>
    </div>
  </div></div>
</section>

<%- include('partials/footer') %>
<script>
  const nav = document.getElementById('nav'); nav.classList.add('solid');
  const io = new IntersectionObserver((es) => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { threshold: .08, rootMargin: '0px 0px -4% 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
</body>
</html>
