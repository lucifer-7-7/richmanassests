    </div>
    <% } else {
      var bedsLabel = (!isLandOrPlot && p.beds && p.beds !== '—' && p.beds !== 'N/A') ? (/bhk|bed/i.test(p.beds) ? p.beds : p.beds + ' Bedrooms') : null;
    %>
    <div class="setting reveal">
      <div class="kicker" style="margin-bottom:18px"><%= p.setting_kicker %></div>
      <h3>Property details</h3>
      <ul class="amen facts-list">
        <li><span class="d"></span>Verified &amp; title-checked listing</li>
        <% if (typeof postedAgo !== 'undefined' && postedAgo) { %><li><span class="d"></span>Listed <%= postedAgo %></li><% } %>
        <% if (p.subtype) { %><li><span class="d"></span><%= p.subtype %></li><% } %>
        <% if (p.sqft) { %><li><span class="d"></span><%= isLandOrPlot ? 'Land area' : 'Built-up area' %>: <%= p.sqft %></li><% } %>
        <% if (bedsLabel) { %><li><span class="d"></span><%= bedsLabel %><% if (p.baths && p.baths !== '—' && p.baths !== 'N/A') { %> · <%= p.baths %> Bathrooms<% } %></li><% } %>
        <% if (p.emi_val && p.listing === 'sale') { %><li><span class="d"></span>EMI from <%= p.emi_val %>/mo</li><% } %>
      </ul>
      <% if (p.price_note) { %>
      <div class="loan-chip">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        <%= p.price_note %>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>
</section>

<% if (similar && similar.length > 0) { %>
<section class="similar wrap">
  <div class="shead">
    <div class="l">
      <span class="kicker"><span class="gold-line"></span>You might also like</span>
      <h2 style="font-family:var(--f-display);font-weight:500;font-size:clamp(26px,3.4vw,42px);margin-top:12px;letter-spacing:-.01em">Similar homes</h2>
    </div>
    <a class="tlink" href="/properties">All listings <span class="arr">→</span></a>
  </div>
  <div class="plist-grid">
    <% similar.forEach(function(s) { %>
    <a class="plist" href="<%= s.is_builder_project ? ('/builder-project/' + s.slug) : ('/property/' + s.id) %>" style="text-decoration:none">
      <div class="ph">
        <% var simImg = s.img_card || s.img_hero; %>
        <% if (simImg) { %>
        <img src="<%= simImg.startsWith('http') ? simImg : '/' + simImg.replace(/^\//, '') %>" alt="<%= s.name %>, <%= s.loc %>" loading="lazy">
        <% } else { %><div class="ph-placeholder"><span>Photos on request</span></div><% } %>
        <span class="badge <%= s.listing %>"><%= s.listing === 'sale' ? 'For Sale' : s.listing === 'rent' ? 'For Rent' : 'For Lease' %></span>
      </div>
      <div class="body">
        <div class="price"><%= s.price %></div>
        <h3><%= s.name %></h3>
        <div class="loc">
          <svg class="pin" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6.5C8 3.5 4.5 3.5 4.5 6.5 4.5 9 8 11 8 11s3.5-2 3.5-4.5C11.5 3.5 8 3.5 8 6.5z"/><circle cx="8" cy="6.4" r="1.2"/></svg>
          <%= s.loc %> · <%= s.type %>
        </div>
        <div class="cta"><span class="v">View home &rarr;</span></div>
      </div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (next) { %>
<a class="p-next" href="<%= next.is_builder_project ? ('/builder-project/' + next.slug) : ('/property/' + next.id) %>">
  <% var nextImg = next.img_card || next.img_hero; %>
  <% if (nextImg) { %><img src="<%= nextImg.startsWith('http') ? nextImg : '/' + nextImg.replace(/^\//, '') %>" alt="<%= next.name %>, <%= next.loc %>" loading="lazy"><% } %>
  <div class="scrim"></div>
  <div class="nx">
    <span class="k">Next listing</span>
    <h3><%= next.name %><span class="arr">→</span></h3>
    <span class="loc"><%= next.loc %> · <%= next.price %></span>
  </div>
</a>
<% } %>

<div style="display:none!important;" aria-hidden="true">
  <%- include('partials/footer') %>
</div>

<!-- ENQUIRY MODAL -->
<div class="apc-modal" id="enquiryModal" aria-hidden="true">
  <div class="apc-modal-overlay" onclick="closeEnquiryModal()"></div>
  <div class="apc-modal-card">
    <button type="button" class="apc-modal-close" onclick="closeEnquiryModal()" aria-label="Close">✕</button>
    <div class="apc-modal-header">
      <div class="apc-modal-badge">Direct Property Enquiry</div>
      <h3>Contact Listing Agent</h3>
      <p style="font-size:13px;color:var(--muted);margin-top:2px;">Inquiring about <strong><%= p.name %></strong> (<%= p.price %>)</p>
    </div>

    <form id="propertyEnquiryForm" onsubmit="handleEnquirySubmit(event)">
      <div style="margin-bottom:14px;">
        <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;color:var(--ink);">Your Name <span style="color:#D93838">*</span></label>
        <input type="text" name="name" id="enqName" required placeholder="e.g. Rahul Sharma" style="width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;outline:none;">
      </div>

      <div style="margin-bottom:14px;">
        <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;color:var(--ink);">Phone Number <span style="color:#D93838">*</span></label>
        <input type="tel" name="phone" id="enqPhone" required placeholder="e.g. +91 98765 43210" style="width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;outline:none;">
      </div>

      <div style="margin-bottom:14px;">
        <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;color:var(--ink);">Email Address (Optional)</label>
        <input type="email" name="email" id="enqEmail" placeholder="rahul@example.com" style="width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;outline:none;">
      </div>

      <div style="margin-bottom:18px;">
        <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px;color:var(--ink);">Message</label>
        <textarea name="message" id="enqMsg" placeholder="Hi, I would like to schedule a site visit or ask about documentation for this property." style="width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:13.5px;min-height:75px;outline:none;resize:vertical;"></textarea>
      </div>

      <div id="enqStatus" style="display:none;font-size:13px;font-weight:600;margin-bottom:14px;padding:10px 14px;border-radius:8px;"></div>

      <button type="submit" id="enqBtn" class="btn btn-dark" style="width:100%;justify-content:center;height:46px;border-radius:999px;font-weight:700;font-size:14px;">
        <span>Send &amp; Open WhatsApp</span> &rarr;
      </button>
    </form>
  </div>
</div>

<script>
  const nav = document.getElementById('nav');
  const onScroll = () => nav.classList.toggle('solid', window.scrollY > window.innerHeight * .72);
  onScroll(); addEventListener('scroll', onScroll, { passive: true });
  const io = new IntersectionObserver((es) => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { threshold: .1, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  function openEnquiryModal() {
    document.getElementById('enquiryModal').classList.add('open');
    document.getElementById('enquiryModal').setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeEnquiryModal() {
    document.getElementById('enquiryModal').classList.remove('open');
    document.getElementById('enquiryModal').setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  async function handleEnquirySubmit(e) {
    e.preventDefault();
    var btn = document.getElementById('enqBtn');
    var statusDiv = document.getElementById('enqStatus');
    btn.disabled = true;
    btn.innerText = 'Submitting...';

    try {
      var resp = await fetch('/property/<%= p.id %>/enquire', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: document.getElementById('enqName').value,
          phone: document.getElementById('enqPhone').value,
          email: document.getElementById('enqEmail').value,
          message: document.getElementById('enqMsg').value,
        })
      });
      var data = await resp.json();
      if (data.ok) {
        statusDiv.style.display = 'block';
        statusDiv.style.background = '#F0FAF4';
        statusDiv.style.color = '#166534';
        statusDiv.style.border = '1px solid #BBF7D0';
        statusDiv.innerText = '✓ Enquiry saved! Opening WhatsApp...';
        setTimeout(function() {
          closeEnquiryModal();
          if (data.whatsappUrl) {
            window.open(data.whatsappUrl, '_blank');
          }
        }, 800);
      } else {
        statusDiv.style.display = 'block';
        statusDiv.style.background = '#FDF2F2';
        statusDiv.style.color = '#991B1B';
        statusDiv.style.border = '1px solid #FECACA';
        statusDiv.innerText = data.error || 'Failed to send enquiry';
        btn.disabled = false;
        btn.innerHTML = '<span>Send &amp; Open WhatsApp</span> &rarr;';
      }
    } catch (err) {
      statusDiv.style.display = 'block';
      statusDiv.style.background = '#FDF2F2';
      statusDiv.style.color = '#991B1B';
      statusDiv.style.border = '1px solid #FECACA';
      statusDiv.innerText = 'Network error. Please try again.';
      btn.disabled = false;
      btn.innerHTML = '<span>Send &amp; Open WhatsApp</span> &rarr;';
    }
  }
</script>
</body>
</html>
