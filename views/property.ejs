<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
<link rel="stylesheet" href="/assets/property.css">
</head>
<body data-screen-label="<%= p.name %>" class="has-prop-cta">

<%- include('partials/nav') %>

<!-- Mobile sticky CTA -->
<div class="prop-sticky-cta">
  <div class="cta-price">
    <div class="p"><%= p.price %><% if (p.price_note) { %><small style="font-size:11px;font-weight:400;color:var(--muted)"> <%= p.price_note %></small><% } %></div>
    <div class="t"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %> · <%= p.type %></div>
  </div>
  <div class="cta-actions">
    <a class="cta-wa" href="https://wa.me/919036001234?text=<%= encodeURIComponent('Hi RichManAssets, I\'m interested in ' + p.name + ' (' + p.loc + ', ' + p.price + ').') %>" target="_blank" rel="noopener" aria-label="WhatsApp">
      <svg viewBox="0 0 32 32" fill="none"><path d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.4.7 4.6 1.8 6.5L3 29l7.2-2.2c1.8 1 3.8 1.5 5.8 1.5 7 0 12.5-5.5 12.5-12.5S23 3 16 3z" fill="currentColor" stroke="none"/><path d="M11.2 9.3c-.3-.6-.5-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.8s1.2 3.3 1.4 3.5c.2.2 2.4 3.8 5.9 5.2 2.9 1.1 3.5.9 4.2.9.7-.1 2.1-.9 2.4-1.7.3-.8.3-1.6.2-1.7-.1-.2-.3-.2-.7-.4-.3-.2-2.1-1-2.4-1.1-.3-.1-.6-.2-.8.2-.2.3-.9 1.1-1.1 1.4-.2.2-.4.2-.7.1-.4-.2-1.6-.6-3-1.8-1.1-1-1.9-2.2-2.1-2.6-.2-.4 0-.5.2-.7.2-.2.4-.4.5-.6.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6 0-.2-.7-2-1-2.7z" fill="#fff" stroke="none"/></svg>
    </a>
    <a class="cta-btn" href="/properties" style="gap:6px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <span>Search</span>
    </a>
  </div>
</div>

<!-- DESKTOP MOSAIC GALLERY SECTION (860px+) -->
<section class="dt-gallery-sec">
  <div class="dt-gallery-head">
    <div>
      <div class="crumb" style="margin-bottom:8px;">
        <a href="/">Home</a><span class="sep">/</span><a href="/properties">Properties</a><span class="sep">/</span><span><%= p.name %></span>
      </div>
      <h1><%= p.name %></h1>
      <div class="meta-pills">
        <span class="pbadge <%= p.listing %>"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %></span>
        <span class="pbadge"><%= p.type %></span>
        <span style="font-family:var(--f-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)"><%= p.loc %></span>
      </div>
    </div>
    <div style="text-align:right;">
      <div style="font-family:var(--f-display);font-size:32px;font-weight:600;color:var(--ink);letter-spacing:-.01em;"><%= p.price %><% if (p.price_note) { %><small style="font-size:14px;font-weight:400;color:var(--muted)"> <%= p.price_note %></small><% } %></div>
      <div style="font-family:var(--f-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-deep);margin-top:4px;">Verified Title-Checked Listing</div>
    </div>
  </div>

  <% var pImgs = (typeof allImages !== 'undefined' && allImages.length) ? allImages : [p.img_hero || p.img_card].filter(Boolean); %>
  <% var fallbackMain = pImgs[0] || ''; %>
  <div class="dt-gallery-grid dt-count-<%= Math.min(pImgs.length, 5) %>">
    <div class="dt-gallery-main" onclick="openLightbox(0)">
      <img src="<%= pImgs[0] %>" alt="<%= p.name %> Main Hero" loading="eager" onerror="this.src='<%= fallbackMain %>';this.onerror=null;">
    </div>
    <% if (pImgs.length > 1) { %>
    <div class="dt-gallery-side dt-side-count-<%= Math.min(pImgs.length - 1, 4) %>">
      <% pImgs.slice(1, 5).forEach(function(imgUrl, idx) { %>
      <div class="dt-gallery-tile" onclick="openLightbox(<%= idx + 1 %>)">
        <img src="<%= imgUrl %>" alt="<%= p.name %> Photo <%= idx + 2 %>" loading="lazy" onerror="this.src='<%= fallbackMain %>';this.onerror=null;">
        <% if (idx === 3 && pImgs.length > 5) { %>
        <div class="dt-more-overlay">+<%= pImgs.length - 5 %> Photos</div>
        <% } %>
      </div>
      <% }); %>
    </div>
    <% } %>
    <button class="btn-all-photos" onclick="openLightbox(0)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      View All Photos (<%= pImgs.length %>)
    </button>
  </div>
</section>

<!-- MOBILE HERO (Mobile only <860px) -->
<header class="phero">
  <div class="phero-slider" id="pheroSlider">
    <% pImgs.forEach(function(imgUrl, idx) { %>
    <div class="phero-slide" onclick="openLightbox(<%= idx %>)">
      <img src="<%= imgUrl %>" alt="<%= p.name %> Photo <%= idx + 1 %>" loading="<%= idx === 0 ? 'eager' : 'lazy' %>" onerror="this.src='<%= fallbackMain %>';this.onerror=null;">
    </div>
    <% }); %>
  </div>
  <div class="scrim"></div>
  <div class="phero-inner">
    <div class="badge-row">
      <span class="pbadge <%= p.listing %>"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %></span>
      <span class="pbadge"><%= p.type %></span>
    </div>
    <div class="eyebrow"><span class="ln"></span><span><%= p.loc %></span></div>
    <h1><%= p.name %></h1>
    <div class="pprice-wrap" style="display:flex;justify-content:space-between;align-items:flex-end;">
      <div class="pprice"><%= p.price %><% if (p.price_note) { %><small> <%= p.price_note %></small><% } %></div>
      <% if (pImgs.length > 1) { %>
      <span style="font-family:var(--f-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,0.85);background:rgba(10,9,6,0.5);padding:4px 10px;border-radius:100px;">Swipe &rarr; (1/<%= pImgs.length %>)</span>
      <% } %>
    </div>
  </div>
</header>

<!-- Lightbox Modal -->
<div class="gallery-modal" id="galLb" aria-hidden="true">
  <button class="gallery-modal-close" onclick="closeLightbox()" aria-label="Close">✕</button>
  <div class="gallery-modal-content">
    <img class="lb-img" id="lbImg" alt="<%= p.name %> photo">
    <div class="gallery-modal-nav">
      <button class="gallery-modal-btn" onclick="lbMove(-1)" aria-label="Previous">&#8592;</button>
      <button class="gallery-modal-btn" onclick="lbMove(1)" aria-label="Next">&#8594;</button>
    </div>
    <div style="font-family:var(--f-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,0.7);margin-top:14px;" id="lbCounter"></div>
  </div>
</div>

<script>
var lbImages = <%- JSON.stringify(typeof allImages !== 'undefined' ? allImages : [p.img_hero, p.img_card].filter(Boolean)) %>;
var lbIndex = 0;

function openLightbox(idx) {
  lbIndex = idx || 0;
  updateLb();
  document.getElementById('galLb').classList.add('open');
  document.getElementById('galLb').setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}

function closeLightbox() {
  document.getElementById('galLb').classList.remove('open');
  document.getElementById('galLb').setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

function lbMove(dir) {
  if (!lbImages.length) return;
  lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
  updateLb();
}

function updateLb() {
  if (!lbImages.length) return;
  var imgEl = document.getElementById('lbImg');
  imgEl.onerror = function() { this.src = '<%= fallbackMain %>'; this.onerror = null; };
  imgEl.src = lbImages[lbIndex];
  document.getElementById('lbCounter').innerText = (lbIndex + 1) + ' / ' + lbImages.length;
}

document.addEventListener('keydown', function(e) {
  if (!document.getElementById('galLb').classList.contains('open')) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft') lbMove(-1);
  if (e.key === 'ArrowRight') lbMove(1);
});
</script>

<section class="specs">
  <div class="wrap"><div class="specs-in">
    <div class="spec"><h6>Price</h6><div class="v" style="font-size:clamp(20px,2vw,26px)"><%= p.price %></div></div>
    <div class="spec"><h6>Listing</h6><div class="v" style="font-size:clamp(17px,1.7vw,22px)"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %></div></div>
    <div class="spec"><h6>Type</h6><div class="v" style="font-size:clamp(17px,1.7vw,22px)"><%= p.type %></div></div>
    <% if (p.beds && p.beds !== '—') { %><div class="spec"><h6>Bedrooms</h6><div class="v"><%= p.beds %></div></div><% } %>
    <% if (p.baths && p.baths !== '—') { %><div class="spec"><h6>Bathrooms</h6><div class="v"><%= p.baths %></div></div><% } %>
    <% if (p.sqft) { %><div class="spec"><h6>Area</h6><div class="v" style="font-size:clamp(17px,1.7vw,22px)"><%= p.sqft %> sq ft</div></div><% } %>
  </div></div>
</section>

<section class="story wrap">
  <div class="story-grid with-buy">
    <div class="reveal">
      <% if (p.story_kicker) { %><div class="kicker lead-k"><%= p.story_kicker %></div><% } %>
      <% if (p.story_heading) { %><h2><%- p.story_heading.replace(' water.', ' <span class="it">water.</span>').replace(' years.', ' <span class="it">years.</span>').replace(' mist.', ' <span class="it">mist.</span>').replace(' open.', ' <span class="it">open.</span>').replace(' enough.', ' <span class="it">enough.</span>').replace(' address.', ' <span class="it">address.</span>').replace(' quickly.', ' <span class="it">quickly.</span>').replace(' scale.', ' <span class="it">scale.</span>').replace(' forgot.', ' <span class="it">forgot.</span>').replace(' sea.', ' <span class="it">sea.</span>') %></h2><% } %>
      <% if (p.story_body) {
        const paras = p.story_body.split('\n\n');
        paras.forEach(function(para) { if (para.trim()) { %>
      <p><%= para.trim() %></p>
      <% }})} %>
      <!-- Story Section Photo & Small Thumbnail Preview -->
      <div class="story-media-sec reveal" style="margin-top:32px;width:100%;">
        <div class="story-media-title" style="font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;font-weight:600;display:flex;justify-content:space-between;align-items:center;">
          <span>Property Gallery</span>
          <span><%= pImgs.length %> <%= pImgs.length === 1 ? 'Photo' : 'Photos' %></span>
        </div>
        
        <!-- Big Main Image -->
        <figure class="figcrop" onclick="openLightbox(0)" style="aspect-ratio:16/10;cursor:pointer;border-radius:14px;overflow:hidden;border:1px solid var(--line-soft);">
          <img src="<%= pImgs[0] %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='<%= fallbackMain %>';this.onerror=null;">
        </figure>

        <!-- Small Stacked Thumbnails Preview -->
        <% if (pImgs.length > 1) { %>
        <div class="story-thumb-preview" style="display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin-top:12px;padding-bottom:4px;">
          <% pImgs.forEach(function(imgUrl, idx) { %>
          <div class="story-thumb-item" onclick="openLightbox(<%= idx %>)" style="flex:0 0 96px;aspect-ratio:16/11;border-radius:8px;overflow:hidden;border:1px solid var(--line-soft);position:relative;cursor:pointer;background:var(--paper-2);scroll-snap-align:start;">
            <img src="<%= imgUrl %>" alt="<%= p.name %> Thumb <%= idx + 1 %>" loading="lazy" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='<%= fallbackMain %>';this.onerror=null;">
            <span style="position:absolute;bottom:4px;right:4px;font-family:var(--f-mono);font-size:8.5px;color:#FFF;background:rgba(10,9,6,0.7);padding:2px 5px;border-radius:4px;"><%= idx + 1 %></span>
          </div>
          <% }); %>
        </div>
        <% } %>
        <!-- Book a Visit CTA inside mobile property page -->
        <div class="mobile-visit-btn-wrap" style="margin-top:16px;">
          <a class="btn btn-dark" href="/contact?ref=<%= p.id %>" style="width:100%;justify-content:center;min-height:48px;border-radius:100px;font-size:14px;font-weight:600;">
            <span>Book a visit</span><span class="arr">&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <aside class="buy-card-wrap reveal">
      <div class="buy-card">
        <div class="bc-price"><%= p.price %><% if (p.price_note) { %><small> <%= p.price_note %></small><% } %></div>
        <div class="bc-sub"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %> · <%= p.type %> · <%= p.loc %></div>
        <% if (p.emi_val && p.listing === 'sale') { %>
        <div class="bc-emi">
          <div class="l">Est. EMI<br><span style="font-size:11px;color:var(--muted)"><%= p.emi_label %></span></div>
          <div style="text-align:right"><div class="v"><%= p.emi_val %><small style="font-size:12px;font-weight:400">/mo</small></div><a href="/loans">Calculate yours →</a></div>
        </div>
        <% } %>
        <div class="bc-actions">
          <a class="btn btn-dark" href="/contact?ref=<%= p.id %>"><span>Book a visit</span><span class="arr">→</span></a>
          <div class="bc-row">
            <a class="bc-wa btn" href="https://wa.me/919036001234?text=<%= encodeURIComponent('Hi RichManAssets, I\'m interested in ' + p.name + ' (' + p.loc + ', ' + p.price + ').') %>" target="_blank" rel="noopener" style="gap:8px"><span>WhatsApp</span></a>
            <a class="bc-call" href="tel:+919036001234" aria-label="Call">
              <svg viewBox="0 0 32 32" fill="currentColor"><path d="M6 3h5l2 6-3 2c1 3 3 5 6 6l2-3 6 2v5c0 1-1 2-2 2C13 26 6 19 6 6c0-1 0-3 0-3z"/></svg>
            </a>
          </div>
        </div>
        <p class="bc-note">Talk to a real specialist for a same-day reply. No pressure, honest advice on price &amp; papers.</p>
      </div>
    </aside>
  </div>
</section>




<section class="feat wrap">
  <div class="feat-grid">
    <% if (p.amenities) { %>
    <div class="reveal">
      <div class="kicker" style="margin-bottom:18px">What's here</div>
      <h3>The essentials</h3>
      <ul class="amen">
        <% p.amenities.split('|').forEach(function(a) { if (a.trim()) { %>
        <li><span class="d"></span><%= a.trim() %></li>
        <% }}); %>
      </ul>
    </div>
    <% } %>
    <% if (p.setting_heading) { %>
    <div class="setting reveal">
      <div class="kicker" style="margin-bottom:18px">The setting</div>
      <h3><%= p.setting_heading %></h3>
      <% if (p.setting_body) {
        const paras = p.setting_body.split('\n\n');
        paras.forEach(function(para) { if (para.trim()) { %>
      <p><%= para.trim() %></p>
      <% }})} %>
      <% if (p.setting_pills) { %>
      <div class="pill-row">
        <% p.setting_pills.split('|').forEach(function(pill) { if (pill.trim()) { %>
        <span class="pill"><%= pill.trim() %></span>
        <% }}); %>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>
</section>

<% if (similar && similar.length > 0) { %>
<section class="similar wrap">
  <div class="shead">
    <div class="l">
      <span class="kicker"><span class="gold-line"></span>You might also like</span>
      <h2 style="font-family:var(--f-display);font-weight:500;font-size:clamp(26px,3.4vw,42px);margin-top:12px;letter-spacing:-.01em">Similar homes</h2>
    </div>
    <a class="tlink" href="/properties">All listings <span class="arr">→</span></a>
  </div>
  <div class="plist-grid">
    <% similar.forEach(function(s) { %>
    <a class="plist" href="/property/<%= s.id %>" style="text-decoration:none">
      <div class="ph">
        <% if (s.img_card) { %>
        <img src="/<%= s.img_card %>" alt="<%= s.name %>, <%= s.loc %>" loading="lazy">
        <% } else { %><div class="ph-placeholder"><span>Photos on request</span></div><% } %>
        <span class="badge <%= s.listing %>"><%= s.listing === 'sale' ? 'For Sale' : s.listing === 'rent' ? 'For Rent' : 'For Lease' %></span>
      </div>
      <div class="body">
        <div class="price"><%= s.price %></div>
        <h3><%= s.name %></h3>
        <div class="loc">
          <svg class="pin" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6.5C8 3.5 4.5 3.5 4.5 6.5 4.5 9 8 11 8 11s3.5-2 3.5-4.5C11.5 3.5 8 3.5 8 6.5z"/><circle cx="8" cy="6.4" r="1.2"/></svg>
          <%= s.loc %> · <%= s.type %>
        </div>
        <div class="cta"><span class="v" style="display:block">View home</span></div>
      </div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<% if (next) { %>
<a class="p-next" href="/property/<%= next.id %>">
  <% if (next.img_card) { %><img src="/<%= next.img_card %>" alt="<%= next.name %>, <%= next.loc %>" loading="lazy"><% } %>
  <div class="scrim"></div>
  <div class="nx">
    <span class="k">Next listing</span>
    <h3><%= next.name %><span class="arr">→</span></h3>
    <span class="loc"><%= next.loc %> · <%= next.price %></span>
  </div>
</a>
<% } %>

<div style="display:none!important;" aria-hidden="true">
  <%- include('partials/footer') %>
</div>

<script>
  const nav = document.getElementById('nav');
  const onScroll = () => nav.classList.toggle('solid', window.scrollY > window.innerHeight * .72);
  onScroll(); addEventListener('scroll', onScroll, { passive: true });
  const io = new IntersectionObserver((es) => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { threshold: .1, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
</body>
</html>
