      <% if (p.story_body) {
        const paras = p.story_body.split('\n\n');
        paras.forEach(function(para) { if (para.trim()) { %>
      <p><%= para.trim() %></p>
      <% }})} else if (p.description) {
        const paras = p.description.split('\n\n');
        paras.forEach(function(para) { if (para.trim()) { %>
      <p><%= para.trim() %></p>
      <% }})} %>
      <!-- Story Section Photo & Small Thumbnail Preview -->
      <div class="story-media-sec reveal" style="margin-top:32px;width:100%;">
        <div class="story-media-title" style="font-family:var(--f-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;font-weight:600;display:flex;justify-content:space-between;align-items:center;">
          <span>Property Gallery</span>
          <span><%= pImgs.length %> <%= pImgs.length === 1 ? 'Photo' : 'Photos' %></span>
        </div>
        
        <!-- Big Main Image -->
        <figure class="figcrop" onclick="openLightbox(0)" style="aspect-ratio:16/10;cursor:pointer;border-radius:14px;overflow:hidden;border:1px solid var(--line-soft);">
          <img src="<%= pImgs[0] %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='<%= fallbackMain %>';this.onerror=null;">
        </figure>

        <!-- Small Stacked Thumbnails Preview -->
        <% if (pImgs.length > 1) { %>
        <div class="story-thumb-preview" style="display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;margin-top:12px;padding-bottom:4px;">
          <% pImgs.forEach(function(imgUrl, idx) { %>
          <div class="story-thumb-item" onclick="openLightbox(<%= idx %>)" style="flex:0 0 96px;aspect-ratio:16/11;border-radius:8px;overflow:hidden;border:1px solid var(--line-soft);position:relative;cursor:pointer;background:var(--paper-2);scroll-snap-align:start;">
            <img src="<%= imgUrl %>" alt="<%= p.name %> Thumb <%= idx + 1 %>" loading="lazy" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='<%= fallbackMain %>';this.onerror=null;">
            <span style="position:absolute;bottom:4px;right:4px;font-family:var(--f-mono);font-size:8.5px;color:#FFF;background:rgba(10,9,6,0.7);padding:2px 5px;border-radius:4px;"><%= idx + 1 %></span>
          </div>
          <% }); %>
        </div>
        <% } %>
        <!-- Book a Visit CTA inside mobile property page -->
        <div class="mobile-visit-btn-wrap" style="margin-top:16px;">
          <a class="btn btn-dark" href="/contact?ref=<%= p.id %>" style="width:100%;justify-content:center;min-height:48px;border-radius:100px;font-size:14px;font-weight:600;">
            <span>Book a visit</span><span class="arr">&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <aside class="buy-card-wrap reveal">
      <div class="buy-card">
        <!-- AGENT PROFILE CARD (MINIMAL) -->
        <div class="agent-profile-card">
          <div class="apc-header">
            <div class="apc-avatar">
              <%= (typeof agentInfo !== 'undefined' && agentInfo && agentInfo.name) ? agentInfo.name.charAt(0).toUpperCase() : 'R' %>
            </div>
            <div class="apc-details">
              <div class="apc-name">
                <%= (typeof agentInfo !== 'undefined' && agentInfo && agentInfo.name) ? agentInfo.name : 'RichManAssets Advisory' %>
                <% if (typeof agentInfo !== 'undefined' && agentInfo && agentInfo.is_verified) { %>
                <span class="apc-badge" title="Verified Agent">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  Verified
                </span>
                <% } %>
              </div>
              <div class="apc-sub">
                <%= (typeof agentInfo !== 'undefined' && agentInfo && agentInfo.company_name) ? agentInfo.company_name : 'Licensed Real Estate Partner' %>
              </div>
              <% if (typeof agentInfo !== 'undefined' && agentInfo && agentInfo.rera_number) { %>
              <div class="apc-rera">RERA: <%= agentInfo.rera_number %></div>
              <% } %>
            </div>
          </div>

          <div class="apc-posted">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span><%= (typeof postedAgo !== 'undefined' && postedAgo) ? postedAgo : 'Recently listed' %></span>
          </div>

          <div class="apc-actions">
