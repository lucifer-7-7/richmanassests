<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
<link rel="stylesheet" href="/assets/property.css">
</head>
<body data-screen-label="<%= p.name %>" class="has-prop-cta">

<%- include('partials/nav') %>

<!-- Mobile sticky CTA -->
<div class="prop-sticky-cta">
  <div class="cta-price">
    <div class="p"><%= p.price %><% if (p.price_note) { %><small style="font-size:11px;font-weight:400;color:var(--muted)"> <%= p.price_note %></small><% } %></div>
    <div class="t"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %> · <%= p.type %></div>
  </div>
  <div class="cta-actions">
    <a class="cta-wa" href="https://wa.me/919380939961?text=<%= encodeURIComponent('Hi RichManAssets, I\'m interested in ' + p.name + ' (' + p.loc + ', ' + p.price + ').') %>" target="_blank" rel="noopener" aria-label="WhatsApp">
      <svg viewBox="0 0 32 32" fill="none"><path d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.4.7 4.6 1.8 6.5L3 29l7.2-2.2c1.8 1 3.8 1.5 5.8 1.5 7 0 12.5-5.5 12.5-12.5S23 3 16 3z" fill="currentColor" stroke="none"/><path d="M11.2 9.3c-.3-.6-.5-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.8s1.2 3.3 1.4 3.5c.2.2 2.4 3.8 5.9 5.2 2.9 1.1 3.5.9 4.2.9.7-.1 2.1-.9 2.4-1.7.3-.8.3-1.6.2-1.7-.1-.2-.3-.2-.7-.4-.3-.2-2.1-1-2.4-1.1-.3-.1-.6-.2-.8.2-.2.3-.9 1.1-1.1 1.4-.2.2-.4.2-.7.1-.4-.2-1.6-.6-3-1.8-1.1-1-1.9-2.2-2.1-2.6-.2-.4 0-.5.2-.7.2-.2.4-.4.5-.6.2-.2.2-.3.3-.6.1-.2 0-.4 0-.6 0-.2-.7-2-1-2.7z" fill="#fff" stroke="none"/></svg>
    </a>
    <a class="cta-btn" href="/properties" style="gap:6px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <span>Search</span>
    </a>
  </div>
</div>

<!-- DESKTOP MOSAIC GALLERY SECTION (860px+) -->
<section class="dt-gallery-sec">
  <div class="dt-gallery-head">
    <div>
      <div class="crumb" style="margin-bottom:8px;">
        <a href="/">Home</a><span class="sep">/</span><a href="/properties">Properties</a><span class="sep">/</span><span><%= p.name %></span>
      </div>
      <h1><%= p.name %></h1>
      <div class="meta-pills">
        <span class="pbadge <%= p.listing %>"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %></span>
        <span class="pbadge"><%= p.type %></span>
        <span style="font-family:var(--f-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)"><%= p.loc %></span>
      </div>
    </div>
    <div style="text-align:right;">
      <div style="font-family:var(--f-display);font-size:32px;font-weight:600;color:var(--ink);letter-spacing:-.01em;"><%= p.price %></div>
      <div style="font-family:var(--f-mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold-deep);margin-top:4px;">Verified Title-Checked Listing</div>
      <% if (p.price_note) { %>
      <div class="loan-chip" style="margin-top:8px;"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg><%= p.price_note %></div>
      <% } %>
    </div>
  </div>

  <% 
