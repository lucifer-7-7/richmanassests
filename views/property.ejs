    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px;opacity:0.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    <div style="font-size:15px;font-weight:600">No property photos uploaded</div>
  </div>
  <% } else { %>
  <div class="dt-hero-single-wrap" style="position:relative;margin-bottom:14px;border-radius:16px;overflow:hidden;border:1px solid var(--line-soft);cursor:pointer;background:var(--paper-2);" onclick="openLightbox(0)">
    <img src="<%= pImgs[0] %>" alt="<%= p.name %> Main Hero" style="width:100%;height:auto;max-height:580px;object-fit:cover;display:block;">
    <button class="btn-all-photos" onclick="event.stopPropagation();openLightbox(0)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      View All Photos (<%= pImgs.length %>)
    </button>
  </div>
  
  <% if (pImgs.length > 1) { %>
  <div class="dt-horizontal-thumbs" style="display:flex;justify-content:center;gap:12px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding-bottom:6px;">
    <% pImgs.forEach(function(imgUrl, idx) { %>
    <div class="dt-thumb-tile" onclick="openLightbox(<%= idx %>)" style="flex:0 0 160px;border-radius:10px;overflow:hidden;border:2px solid <%= idx === 0 ? 'var(--gold-deep)' : 'var(--line-soft)' %>;cursor:pointer;position:relative;">
      <img src="<%= imgUrl %>" alt="<%= p.name %> Photo <%= idx + 1 %>" style="width:100%;height:auto;object-fit:cover;display:block;">
      <span style="position:absolute;bottom:6px;right:6px;font-family:var(--f-mono);font-size:9px;color:#FFF;background:rgba(10,9,6,0.65);padding:2px 6px;border-radius:4px;"><%= idx + 1 %></span>
    </div>
    <% }); %>
  </div>
  <% } %>
  <% } %>

</section>

<!-- MOBILE HERO (Mobile only <860px) -->
<header class="phero">
  <div class="phero-slider" id="pheroSlider">
    <% pImgs.forEach(function(imgUrl, idx) { %>
    <div class="phero-slide" onclick="openLightbox(<%= idx %>)">
      <img src="<%= imgUrl %>" alt="<%= p.name %> Photo <%= idx + 1 %>" loading="<%= idx === 0 ? 'eager' : 'lazy' %>">
    </div>
    <% }); %>

  </div>
  <div class="scrim"></div>
  <div class="phero-inner">
    <div class="badge-row">
      <span class="pbadge <%= p.listing %>"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %></span>
      <span class="pbadge"><%= p.type %></span>
    </div>
    <div class="eyebrow"><span class="ln"></span><span><%= p.loc %></span></div>
    <h1><%= p.name %></h1>
    <div class="pprice-wrap" style="display:flex;justify-content:space-between;align-items:flex-end;">
      <div><div class="pprice"><%= p.price %></div><% if (p.price_note) { %><div class="loan-chip" style="margin-top:6px;color:#FFF;background:rgba(255,255,255,.15);border-color:rgba(255,255,255,.3);"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg><%= p.price_note %></div><% } %></div>
      <% if (pImgs.length > 1) { %>
      <span style="font-family:var(--f-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,0.85);background:rgba(10,9,6,0.5);padding:4px 10px;border-radius:100px;">Swipe &rarr; (1/<%= pImgs.length %>)</span>
      <% } %>
    </div>
  </div>
</header>

<!-- Lightbox Modal -->
<div class="gallery-modal" id="galLb" aria-hidden="true">
  <button class="gallery-modal-close" onclick="closeLightbox()" aria-label="Close">✕</button>
  <div class="gallery-modal-content">
    <img class="lb-img" id="lbImg" alt="<%= p.name %> photo">
    <div class="gallery-modal-nav">
      <button class="gallery-modal-btn" onclick="lbMove(-1)" aria-label="Previous">&#8592;</button>
      <button class="gallery-modal-btn" onclick="lbMove(1)" aria-label="Next">&#8594;</button>
    </div>
    <div style="font-family:var(--f-mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,0.7);margin-top:14px;" id="lbCounter"></div>
  </div>
</div>

<script>
// Format raw numeric price as Indian currency if needed (fallback for old/malformed listings)
function formatPrice(priceStr) {
  if (!priceStr) return priceStr;
  if (/^[₹\s,a-z.A-Z]/.test(priceStr)) return priceStr; // already formatted
  var num = parseInt(priceStr.replace(/\D/g, ''), 10);
  if (isNaN(num)) return priceStr;
  return '₹' + num.toString().replace(/\B(?=(\d{2})+(?!\d))/g, ',');
}

var lbImages = <%- JSON.stringify(typeof allImages !== 'undefined' ? allImages : [p.img_hero, p.img_card].filter(Boolean)) %>;
var lbIndex = 0;

function openLightbox(idx) {
  lbIndex = idx || 0;
  updateLb();
  document.getElementById('galLb').classList.add('open');
  document.getElementById('galLb').setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}

function closeLightbox() {
  document.getElementById('galLb').classList.remove('open');
  document.getElementById('galLb').setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}

function lbMove(dir) {
  if (!lbImages.length) return;
  lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
  updateLb();
}

function updateLb() {
  if (!lbImages.length) return;
  var imgEl = document.getElementById('lbImg');
  imgEl.onerror = function() { this.src = '<%= fallbackMain %>'; this.onerror = null; };
  imgEl.src = lbImages[lbIndex];
  document.getElementById('lbCounter').innerText = (lbIndex + 1) + ' / ' + lbImages.length;
}

document.addEventListener('keydown', function(e) {
  if (!document.getElementById('galLb').classList.contains('open')) return;
  if (e.key === 'Escape') closeLightbox();
  if (e.key === 'ArrowLeft') lbMove(-1);
  if (e.key === 'ArrowRight') lbMove(1);
});
</script>

<section class="specs">
  <div class="wrap"><div class="specs-in">
    <div class="spec"><h6>Price</h6><div class="v" style="font-size:clamp(20px,2vw,26px)"><%= p.price %></div></div>
    <div class="spec"><h6>Listing</h6><div class="v" style="font-size:clamp(17px,1.7vw,22px)"><%= p.listing === 'sale' ? 'For Sale' : p.listing === 'rent' ? 'For Rent' : 'For Lease' %></div></div>
    <div class="spec"><h6>Type</h6><div class="v" style="font-size:clamp(17px,1.7vw,22px)"><%= p.type %></div></div>
    <% // isLandOrPlot is passed from route %>
    <% if (!isLandOrPlot && p.beds && p.beds !== '—' && p.beds !== 'N/A') { %><div class="spec"><h6>Bedrooms</h6><div class="v"><%= p.beds %></div></div><% } %>
    <% if (!isLandOrPlot && p.baths && p.baths !== '—' && p.baths !== 'N/A') { %><div class="spec"><h6>Bathrooms</h6><div class="v"><%= p.baths %></div></div><% } %>
    <% if (p.sqft) { %><div class="spec"><h6><%= isLandOrPlot ? 'Land Area' : 'Area' %></h6><div class="v" style="font-size:clamp(17px,1.7vw,22px)"><%= p.sqft %><% if (!p.sqft.toLowerCase().includes('sq') && !p.sqft.toLowerCase().includes('acre') && !p.sqft.toLowerCase().includes('cent')) { %> sq ft<% } %></div></div><% } %>
    <% if (p.subtype) { %><div class="spec"><h6>Sub-type</h6><div class="v" style="font-size:clamp(15px,1.5vw,20px)"><%= p.subtype %></div></div><% } %>
    <% 
      if (p.details) {
        var parsedDet = {};
        try { parsedDet = typeof p.details === 'string' ? JSON.parse(p.details) : p.details; } catch(_) {}
        Object.keys(parsedDet).forEach(function(key) {
          if (parsedDet[key] && parsedDet[key] !== '—') {
    %>
    <div class="spec"><h6><%= key %></h6><div class="v" style="font-size:clamp(15px,1.5vw,20px)"><%= parsedDet[key] %></div></div>
    <% 
          }
        });
      } 
    %>
  </div></div>
</section>

