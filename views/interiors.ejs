</section>

<!-- COMPLETED PROJECTS & PORTFOLIO HIGHLIGHTS -->
<section class="completed-projects-sec wrap" style="padding: 24px 0 60px; border-top: 1px solid var(--line-soft);">
  <div style="text-align: center; margin-bottom: 40px;">
    <span class="kicker" style="font-family: var(--f-mono); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-deep); font-weight: 700; display: block; margin-bottom: 8px;">Delivered Masterpieces</span>
    <h2 style="font-family: var(--f-display); font-size: clamp(28px, 4vw, 44px); font-weight: 500; color: var(--ink); margin: 0 auto; max-width: 20ch; line-height: 1.1;">Delivered Design Projects</h2>
  </div>

  <div style="display: grid; grid-template-columns: 1fr; gap: 32px; max-width: 900px; margin: 0 auto;">
    <!-- Completed Project Card 1 (Dummy) -->
    <article style="background: var(--white); border: 1.5px solid var(--line); border-radius: var(--r-lg); overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 16px rgba(10,9,6,0.02);">
      <div style="aspect-ratio: 16/9; width: 100%; background: var(--paper-2); overflow: hidden; position: relative; display: flex; align-items: center; justify-content: center;">
        <!-- Placeholder text/graphics until photos are uploaded -->
        <div style="text-align: center; padding: 24px; color: var(--muted);">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="margin-bottom: 12px; opacity: 0.6;"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <div style="font-family: var(--f-sans); font-size: 14px; font-weight: 600;">[Project Photos Upload Pending]</div>
          <div style="font-size: 12px; margin-top: 4px;">Premium layout, custom woodwork, and hand-selected slate details.</div>
        </div>
        <span style="position: absolute; top: 16px; left: 16px; font-family: var(--f-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; padding: 5px 12px; border-radius: var(--r-pill); background: var(--gold-deep); color: #FFF; font-weight: 600;">COMPLETED &amp; DELIVERED</span>
      </div>
      <div style="padding: 28px 24px;">
        <div style="font-family: var(--f-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold-deep); margin-bottom: 8px;">LUXURY BEACHFRONT RESIDENCE</div>
        <h3 style="font-family: var(--f-display); font-size: 26px; font-weight: 500; color: var(--ink); margin-bottom: 12px; line-height: 1.2;">The Ambalpady River-Facing Manor</h3>
        <p style="font-size: 14.5px; line-height: 1.65; color: var(--ink-2); margin-bottom: 20px;">
          Completed in early 2025, this 4-bedroom luxury manor was designed with custom teakwood joinery, automated home intelligence systems, climate-efficient layouts, and marble finishes imported directly from Travertine quarries. Complete turnkey styling including modular kitchen integration and landscaping supervision.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; padding-top: 14px; border-top: 1px solid var(--line-soft);">
          <span style="font-family: var(--f-mono); font-size: 10px; background: var(--paper-2); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--line-soft);">Burma Teak Joinery</span>
          <span style="font-family: var(--f-mono); font-size: 10px; background: var(--paper-2); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--line-soft);">Smart Automation</span>
          <span style="font-family: var(--f-mono); font-size: 10px; background: var(--paper-2); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--line-soft);">Direct-Import Marble</span>
          <span style="font-family: var(--f-mono); font-size: 10px; background: var(--paper-2); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--line-soft);">Ambient Lighting</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
          <div style="font-size: 13.5px; color: var(--muted);"><strong style="color: var(--ink);">Delivered:</strong> Feb 2025 · <strong style="color: var(--ink);">Scale:</strong> 4,200 sq ft</div>
          <a href="/contact?service=interior&ref=Ambalpady-Manor-Delivered" class="btn btn-dark" style="padding: 10px 24px; font-size: 13px; font-weight: 600; border-radius: 100px; text-decoration: none;">Enquire for Similar Projects &rarr;</a>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- DESIGN PROCESS SECTION -->
<section class="interiors-process-sec">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">How We Work</span>
      <h2>Our 3-Step Turnkey Interior Workflow</h2>
    </div>

    <div class="process-grid">
      <div class="process-card">
        <div class="step-num">01 · CONCEPT &amp; 3D RENDERS</div>
        <h3>3D Visualisation &amp; Space Planning</h3>
        <p>We produce photorealistic 3D renders, material mood boards, and detailed floor plans before a single wall is touched.</p>
      </div>

      <div class="process-card">
        <div class="step-num">02 · MATERIAL SELECTION</div>
        <h3>Curated Woods, Stones &amp; Metals</h3>
        <p>You inspect actual wood samples, marble slabs, hardware, and fabrics in person with our senior interior architects.</p>
      </div>

      <div class="process-card">
        <div class="step-num">03 · TURNKEY EXECUTION</div>
        <h3>In-House Joinery &amp; On-Time Delivery</h3>
        <p>Our experienced craftsmen handle all civil, electrical, carpentry, and final styling with fixed timeline guarantees.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA BANNER -->
<section class="interiors-cta-sec wrap">
  <div class="interiors-cta-box">
    <h2>Ready to transform your home or office?</h2>
    <p>Schedule a free consultation and 3D space assessment with RichManAssets' interior design team.</p>
    <a href="/contact?service=interior" class="btn-gold">Book Free Interior Consultation →</a>
  </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/mobile-tabbar') %>

<script>
function filterInteriors(cat, btn) {
  var pills = document.querySelectorAll('#intPills .int-pill');
  pills.forEach(function(p) { p.classList.remove('active'); });
  if (btn) btn.classList.add('active');

  var cards = document.querySelectorAll('#intGrid .int-card');
  cards.forEach(function(card) {
    if (cat === 'all' || card.getAttribute('data-category') === cat) {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });
}
</script>

</body>
</html>
